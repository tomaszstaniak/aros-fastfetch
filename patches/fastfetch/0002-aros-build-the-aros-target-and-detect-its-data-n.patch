diff --git a/src/common/impl/FFPlatform_aros.c b/src/common/impl/FFPlatform_aros.c
new file mode 100644
index 0000000..feaba22
--- /dev/null
+++ b/src/common/impl/FFPlatform_aros.c
@@ -0,0 +1,110 @@
+#include "FFPlatform_private.h"
+#include "common/FFstrbuf.h"
+#include "common/io.h"
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <dos/dosextens.h>
+#include <exec/execbase.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/utsname.h>
+
+// AmigaDOS names: "Vol:" is a volume's root and "Dir/" a drawer, so a
+// separator is added only after a drawer. "Vol:/" would be the parent of
+// the root, which does not exist.
+static void ensureDir(FFstrbuf* path) {
+    if (path->length && !ffStrbufEndsWithC(path, ':') && !ffStrbufEndsWithC(path, '/')) {
+        ffStrbufAppendC(path, '/');
+    }
+}
+
+static void addDir(FFlist* dirs, const char* path) {
+    APTR window = ((struct Process*) FindTask(nullptr))->pr_WindowPtr;
+    ((struct Process*) FindTask(nullptr))->pr_WindowPtr = (APTR) -1; // no "insert volume" requester
+    BPTR lock = Lock((CONST_STRPTR) path, ACCESS_READ);
+    ((struct Process*) FindTask(nullptr))->pr_WindowPtr = window;
+    if (!lock) {
+        return;
+    }
+    UnLock(lock);
+    FF_STRBUF_AUTO_DESTROY buffer = ffStrbufCreateS(path);
+    ensureDir(&buffer);
+    if (!FF_LIST_CONTAINS(*dirs, &buffer, ffStrbufEqual)) {
+        ffStrbufInitMove(FF_LIST_ADD(FFstrbuf, *dirs), &buffer);
+    }
+}
+
+static void nameOfLock(BPTR lock, FFstrbuf* out) {
+    char name[1024];
+    if (lock && NameFromLock(lock, (STRPTR) name, sizeof(name))) {
+        ffStrbufSetS(out, name);
+        ensureDir(out);
+    }
+}
+
+// Mainline stdcio before upstream da9bbd01b5 (2026-09-24; the pool's
+// mainline of 2026-09-23 among them) drops what is still in stdout's buffer
+// when the program ends with output redirected to a file: a short listing
+// came out empty, a longer one cut at a 4096-byte boundary. An explicit
+// flush before the C library closes its streams keeps it.
+static void flushStdout(void) {
+    fflush(stdout);
+}
+
+void ffPlatformInitImpl(FFPlatform* platform) {
+    atexit(flushStdout);
+
+    // AROS has no home directory. User settings live in ENVARC: (kept) and
+    // ENV: (this session's copy, made from ENVARC: at boot); fastfetch's
+    // own files beside the program. ENVARC: comes first: --gen-config
+    // writes into the first directory, and a file only in ENV: would be
+    // gone after the next boot.
+    ffStrbufSetStatic(&platform->homeDir, "ENVARC:");
+    ffStrbufSetStatic(&platform->cacheDir, "T:");
+
+    addDir(&platform->configDirs, "ENVARC:");
+    addDir(&platform->configDirs, "ENV:");
+    addDir(&platform->configDirs, "PROGDIR:");
+
+    nameOfLock(GetProgramDir(), &platform->exePath);
+    if (platform->exePath.length) {
+        char program[256];
+        if (GetProgramName((STRPTR) program, sizeof(program))) {
+            ffStrbufAppendS(&platform->exePath, (const char*) FilePart((STRPTR) program));
+        }
+    }
+    // Presets and logos: PROGDIR:share/fastfetch/..., as on other systems.
+    addDir(&platform->dataDirs, "PROGDIR:share");
+
+    nameOfLock(((struct Process*) FindTask(nullptr))->pr_CurrentDir, &platform->cwd);
+
+    struct CommandLineInterface* cli = Cli();
+    platform->pid = cli ? (uint32_t) ((struct Process*) FindTask(nullptr))->pr_TaskNum : 0;
+    platform->uid = 0;
+
+    // A single-user system: a name only when the user has set one.
+    const char* user = getenv("USER");
+    if (user && *user) {
+        ffStrbufSetS(&platform->userName, user);
+    }
+
+    struct utsname u;
+    if (uname(&u) == 0) {
+        ffStrbufSetS(&platform->hostName, u.nodename);
+        ffStrbufSetS(&platform->sysinfo.version, u.version);
+    }
+    ffStrbufSetStatic(&platform->userShell, "Shell");
+
+    // The kernel is exec.library; its version is what changes with it.
+    ffStrbufSetStatic(&platform->sysinfo.name, "AROS");
+    ffStrbufSetF(&platform->sysinfo.release, "%u.%u", (unsigned) SysBase->LibNode.lib_Version,
+                 (unsigned) SysBase->LibNode.lib_Revision);
+#if defined(__x86_64__)
+    ffStrbufSetStatic(&platform->sysinfo.architecture, "x86_64");
+#elif defined(__aarch64__)
+    ffStrbufSetStatic(&platform->sysinfo.architecture, "aarch64");
+#endif
+    platform->sysinfo.pageSizeShift = 12;
+}
diff --git a/src/common/impl/binary_aros.c b/src/common/impl/binary_aros.c
new file mode 100644
index 0000000..95f5ace
--- /dev/null
+++ b/src/common/impl/binary_aros.c
@@ -0,0 +1,25 @@
+#include "common/binary.h"
+#include "common/io.h"
+
+#include <stdio.h>
+
+// Printable runs in a file, the way `strings` finds them: there is no ELF
+// section reader on AROS, so the whole file is scanned.
+const char* ffBinaryExtractStrings(const char* file, bool (*cb)(const char* str, uint32_t len, void* userdata), void* userdata, uint32_t minLength) {
+    FF_STRBUF_AUTO_DESTROY content = ffStrbufCreate();
+    if (!ffAppendFileBuffer(file, &content)) {
+        return "Failed to read the file";
+    }
+    uint32_t start = 0;
+    for (uint32_t i = 0; i <= content.length; ++i) {
+        unsigned char c = i < content.length ? (unsigned char) content.chars[i] : 0;
+        if (c >= 0x20 && c < 0x7f) {
+            continue;
+        }
+        if (i - start >= minLength && !cb(content.chars + start, i - start, userdata)) {
+            break;
+        }
+        start = i + 1;
+    }
+    return nullptr;
+}
