diff --git a/src/common/aros/aros_compat_abiv11.c b/src/common/aros/aros_compat_abiv11.c
new file mode 100644
index 0000000..e44b99c
--- /dev/null
+++ b/src/common/aros/aros_compat_abiv11.c
@@ -0,0 +1,67 @@
+#include "aros_compat_abiv11.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static int direct(int dirfd, const char* path) {
+    return dirfd == AT_FDCWD || strchr(path, ':') != NULL;
+}
+
+int ffArosOpenat(int dirfd, const char* path, int flags, ...) {
+    if (!direct(dirfd, path)) {
+        errno = ENOSYS;
+        return -1;
+    }
+    va_list ap;
+    va_start(ap, flags);
+    int mode = (flags & O_CREAT) ? va_arg(ap, int) : 0;
+    va_end(ap);
+    return open(path, flags, mode);
+}
+
+int ffArosFstatat(int dirfd, const char* path, struct stat* st, [[maybe_unused]] int flags) {
+    if (!direct(dirfd, path)) {
+        errno = ENOSYS;
+        return -1;
+    }
+    return stat(path, st);
+}
+
+DIR* ffArosFdopendir([[maybe_unused]] int fd) {
+    errno = ENOSYS;
+    return NULL;
+}
+
+ssize_t ffArosGetline(char** line, size_t* size, FILE* stream) {
+    if (!line || !size || !stream) {
+        errno = EINVAL;
+        return -1;
+    }
+    size_t length = 0;
+    int c;
+    while ((c = fgetc(stream)) != EOF) {
+        if (length + 2 > *size) {
+            size_t grown = *size ? *size * 2 : 128;
+            char* p = realloc(*line, grown);
+            if (!p) {
+                errno = ENOMEM;
+                return -1;
+            }
+            *line = p;
+            *size = grown;
+        }
+        (*line)[length++] = (char) c;
+        if (c == '\n') {
+            break;
+        }
+    }
+    if (length == 0) {
+        return -1;
+    }
+    (*line)[length] = '\0';
+    return (ssize_t) length;
+}
diff --git a/src/common/aros/aros_compat_abiv11.h b/src/common/aros/aros_compat_abiv11.h
new file mode 100644
index 0000000..f2ba12f
--- /dev/null
+++ b/src/common/aros/aros_compat_abiv11.h
@@ -0,0 +1,35 @@
+#pragma once
+
+// ABIv11's C library lacks POSIX calls the shared code uses; mainline v1
+// has them. Included into every file of the ABIv11 build only.
+//  - O_CLOEXEC, O_DIRECTORY: no exec() to close across, no flag for
+//    directories: 0.
+//  - openat, fstatat: only AT_FDCWD or a name with a volume ("SYS:x"),
+//    which is all the AROS backend passes; any other ENOSYS.
+//  - fdopendir: ENOSYS (a directory cannot be opened as a descriptor).
+//  - getline: implemented (aros_compat_abiv11.c).
+
+#include <stdio.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <dirent.h>
+
+#ifndef O_CLOEXEC
+    #define O_CLOEXEC 0
+#endif
+#ifndef O_DIRECTORY
+    #define O_DIRECTORY 0
+#endif
+#ifndef AT_FDCWD
+    #define AT_FDCWD (-100)
+#endif
+
+int ffArosOpenat(int dirfd, const char* path, int flags, ...);
+int ffArosFstatat(int dirfd, const char* path, struct stat* st, int flags);
+DIR* ffArosFdopendir(int fd);
+ssize_t ffArosGetline(char** line, size_t* size, FILE* stream);
+
+#define openat ffArosOpenat
+#define fstatat ffArosFstatat
+#define fdopendir ffArosFdopendir
+#define getline ffArosGetline
diff --git a/src/common/aros/aros_output.c b/src/common/aros/aros_output.c
new file mode 100644
index 0000000..e2dfbd8
--- /dev/null
+++ b/src/common/aros/aros_output.c
@@ -0,0 +1,298 @@
+// The stdout filter of aros_output.h. This file calls the real stdio
+// functions, so the macros of the forced include are removed first.
+#undef fwrite
+#undef fputs
+#undef fputc
+#undef putc
+#undef putchar
+#undef puts
+#undef printf
+#undef fprintf
+#undef vprintf
+#undef vfprintf
+#undef fflush
+
+#include "aros_output.h"
+#include "aros_terminal.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+// A sequence split across two writes is kept here until it ends. Longer
+// ones are not SGR colour sequences and are passed on as they are. So is a
+// UTF-8 character split across two writes, for a Latin-1 console.
+static struct {
+    enum { IN_TEXT, IN_ESCAPE, IN_CSI } state;
+    char sequence[64];
+    size_t length;
+    uint32_t scalar;
+    unsigned pending; // continuation bytes still to come
+} filter;
+
+static bool active(FILE* stream) {
+    return stream == stdout && (ffArosTerminalPens() || ffArosTerminalLatin1());
+}
+
+static void emit(const char* bytes, size_t length) {
+    if (length) {
+        fwrite(bytes, 1, length, stdout);
+    }
+}
+
+// sequence: "ESC [ params m". 30-37/40-47 and 90-97/100-107 become
+// 38;5;n / 48;5;n (n 0..15); 38;5;n, 38;2;r;g;b and their 48 forms are
+// copied with their arguments, everything else unchanged.
+static void emitSgr(const char* sequence, size_t length) {
+    char out[192];
+    size_t o = 0;
+    const char* p = sequence + 2;
+    const char* end = sequence + length - 1;
+    memcpy(out, "\033[", 2);
+    o = 2;
+    int skip = 0; // arguments of a 38/48 still to copy unchanged
+    while (p <= end && o < sizeof(out) - 16) {
+        const char* q = p;
+        while (q < end && *q != ';' && *q != ':') {
+            ++q;
+        }
+        char param[16];
+        size_t n = (size_t) (q - p) < sizeof(param) - 1 ? (size_t) (q - p) : sizeof(param) - 1;
+        memcpy(param, p, n);
+        param[n] = 0;
+        char* tail;
+        long v = strtol(param, &tail, 10);
+        bool number = n > 0 && *tail == 0;
+        if (skip > 0) {
+            if (skip == 99) { // the selector after 38/48: 5 has one more, 2 three more
+                skip = number && v == 2 ? 3 : number && v == 5 ? 1 : 0;
+            } else {
+                --skip;
+            }
+            memcpy(out + o, param, n);
+            o += n;
+        } else if (number && ((v >= 30 && v <= 37) || (v >= 90 && v <= 97))) {
+            o += (size_t) snprintf(out + o, sizeof(out) - o, "38;5;%ld", v >= 90 ? v - 90 + 8 : v - 30);
+        } else if (number && ((v >= 40 && v <= 47) || (v >= 100 && v <= 107))) {
+            o += (size_t) snprintf(out + o, sizeof(out) - o, "48;5;%ld", v >= 100 ? v - 100 + 8 : v - 40);
+        } else {
+            if (number && (v == 38 || v == 48)) {
+                skip = 99;
+            }
+            memcpy(out + o, param, n);
+            o += n;
+        }
+        if (q < end) {
+            out[o++] = *q;
+        }
+        p = q + 1;
+    }
+    if (o >= sizeof(out) - 16) { // unexpectedly long: leave it as it was
+        emit(sequence, length);
+        return;
+    }
+    out[o++] = 'm';
+    emit(out, o);
+}
+
+// A character outside Latin-1 as the nearest ASCII, else '?'.
+static void emitScalar(uint32_t scalar) {
+    char c = '?';
+    const char* s = nullptr;
+    if (scalar < 0x100) {
+        c = (char) scalar;
+    } else if (scalar == 0x2010 || scalar == 0x2011 || scalar == 0x2013 || scalar == 0x2014 || scalar == 0x2212) {
+        c = '-';
+    } else if (scalar == 0x2018 || scalar == 0x2019) {
+        c = '\'';
+    } else if (scalar == 0x201C || scalar == 0x201D) {
+        c = '"';
+    } else if (scalar == 0x2022) {
+        c = (char) 0xB7; // middle dot
+    } else if (scalar == 0x2026) {
+        s = "...";
+    } else if (scalar == 0x2713 || scalar == 0x2714) {
+        c = '*'; // check mark
+    }
+    if (s) {
+        emit(s, strlen(s));
+    } else {
+        emit(&c, 1);
+    }
+}
+
+// One byte of text at or above 0x80, for a Latin-1 console.
+static void latin1Byte(unsigned char b) {
+    if (filter.pending && (b & 0xC0) == 0x80) {
+        filter.scalar = (filter.scalar << 6) | (b & 0x3F);
+        if (--filter.pending == 0) {
+            emitScalar(filter.scalar);
+        }
+        return;
+    }
+    if (filter.pending) { // a sequence cut short
+        filter.pending = 0;
+        emit("?", 1);
+    }
+    if ((b & 0xE0) == 0xC0) {
+        filter.scalar = b & 0x1F;
+        filter.pending = 1;
+    } else if ((b & 0xF0) == 0xE0) {
+        filter.scalar = b & 0x0F;
+        filter.pending = 2;
+    } else if ((b & 0xF8) == 0xF0) {
+        filter.scalar = b & 0x07;
+        filter.pending = 3;
+    } else {
+        emit("?", 1);
+    }
+}
+
+static void filterBytes(const char* bytes, size_t length) {
+    size_t start = 0;
+    bool latin1 = ffArosTerminalLatin1();
+    bool pens = ffArosTerminalPens();
+    for (size_t i = 0; i < length; ++i) {
+        char c = bytes[i];
+        switch (filter.state) {
+            case IN_TEXT:
+                if (latin1 && ((unsigned char) c & 0x80)) {
+                    emit(bytes + start, i - start);
+                    start = i + 1;
+                    latin1Byte((unsigned char) c);
+                    break;
+                }
+                if (filter.pending) { // ASCII cuts a sequence short; the range before it is empty
+                    filter.pending = 0;
+                    emit("?", 1);
+                }
+                if (c == '\033') {
+                    emit(bytes + start, i - start);
+                    filter.state = IN_ESCAPE;
+                    filter.sequence[0] = c;
+                    filter.length = 1;
+                }
+                break;
+            case IN_ESCAPE:
+                filter.sequence[filter.length++] = c;
+                if (c == '[') {
+                    filter.state = IN_CSI;
+                } else {
+                    emit(filter.sequence, filter.length);
+                    filter.state = IN_TEXT;
+                    start = i + 1;
+                }
+                break;
+            case IN_CSI:
+                filter.sequence[filter.length++] = c;
+                if (c >= 0x40 && c <= 0x7e) { // final byte
+                    if (c == 'm' && pens) {
+                        emitSgr(filter.sequence, filter.length);
+                    } else {
+                        emit(filter.sequence, filter.length);
+                    }
+                    filter.state = IN_TEXT;
+                    start = i + 1;
+                } else if (filter.length == sizeof(filter.sequence)) {
+                    emit(filter.sequence, filter.length);
+                    filter.state = IN_TEXT;
+                    start = i + 1;
+                }
+                break;
+        }
+    }
+    if (filter.state == IN_TEXT) {
+        emit(bytes + start, length - start);
+    }
+}
+
+size_t ffArosFwrite(const void* ptr, size_t size, size_t count, FILE* stream) {
+    if (!active(stream) || !size || !count) {
+        return fwrite(ptr, size, count, stream);
+    }
+    filterBytes((const char*) ptr, size * count);
+    return ferror(stdout) ? 0 : count;
+}
+
+int ffArosFputs(const char* s, FILE* stream) {
+    if (!active(stream)) {
+        return fputs(s, stream);
+    }
+    filterBytes(s, strlen(s));
+    return ferror(stdout) ? EOF : 0;
+}
+
+int ffArosPutc(int c, FILE* stream) {
+    if (!active(stream)) {
+        return fputc(c, stream);
+    }
+    char b = (char) c;
+    filterBytes(&b, 1);
+    return ferror(stdout) ? EOF : (unsigned char) c;
+}
+
+int ffArosPuts(const char* s) {
+    if (ffArosFputs(s, stdout) == EOF) {
+        return EOF;
+    }
+    return ffArosPutc('\n', stdout) == EOF ? EOF : 0;
+}
+
+int ffArosVfprintf(FILE* stream, const char* format, va_list ap) {
+    if (!active(stream)) {
+        return vfprintf(stream, format, ap);
+    }
+    char small[512];
+    va_list copy;
+    va_copy(copy, ap);
+    int n = vsnprintf(small, sizeof(small), format, ap);
+    if (n < 0) {
+        va_end(copy);
+        return n;
+    }
+    if ((size_t) n < sizeof(small)) {
+        filterBytes(small, (size_t) n);
+    } else {
+        char* big = malloc((size_t) n + 1);
+        if (!big) {
+            va_end(copy);
+            return -1;
+        }
+        vsnprintf(big, (size_t) n + 1, format, copy);
+        filterBytes(big, (size_t) n);
+        free(big);
+    }
+    va_end(copy);
+    return ferror(stdout) ? -1 : n;
+}
+
+int ffArosPrintf(const char* format, ...) {
+    va_list ap;
+    va_start(ap, format);
+    int n = ffArosVfprintf(stdout, format, ap);
+    va_end(ap);
+    return n;
+}
+
+int ffArosFprintf(FILE* stream, const char* format, ...) {
+    va_list ap;
+    va_start(ap, format);
+    int n = ffArosVfprintf(stream, format, ap);
+    va_end(ap);
+    return n;
+}
+
+int ffArosFflush(FILE* stream) {
+    // A sequence still open at a flush is incomplete; it goes out as it
+    // is rather than being held back.
+    if ((stream == stdout || stream == nullptr) && filter.state != IN_TEXT) {
+        emit(filter.sequence, filter.length);
+        filter.state = IN_TEXT;
+    }
+    if ((stream == stdout || stream == nullptr) && filter.pending) {
+        filter.pending = 0;
+        emit("?", 1);
+    }
+    return fflush(stream);
+}
diff --git a/src/common/aros/aros_output.h b/src/common/aros/aros_output.h
new file mode 100644
index 0000000..c79796f
--- /dev/null
+++ b/src/common/aros/aros_output.h
@@ -0,0 +1,42 @@
+#pragma once
+
+// Included into every source file of the AROS build (CMakeLists.txt).
+// All stdio writes to stdout pass through one filter, for two kinds of
+// console (aros_terminal.h):
+// - one that reports Amiga pens (XTY_COLOR_PENS, Limpet's Shell sessions)
+//   shows screen pens 0..7 for SGR 30..37 and 40..47, which fastfetch
+//   writes from many places: those become 38;5;n / 48;5;n, which keep
+//   their ANSI meaning there;
+// - one that shows Latin-1 (CON:) gets UTF-8 text as ISO-8859-1, with '?'
+//   or an ASCII stand-in for what Latin-1 lacks.
+// Writes to other streams, and to stdout redirected to a file or pipe, are
+// passed on unchanged.
+
+#include <stdio.h>
+#include <stdarg.h>
+
+size_t ffArosFwrite(const void* ptr, size_t size, size_t count, FILE* stream);
+int ffArosFputs(const char* s, FILE* stream);
+int ffArosPutc(int c, FILE* stream);
+int ffArosPuts(const char* s);
+int ffArosPrintf(const char* format, ...) __attribute__((__format__(__printf__, 1, 2)));
+int ffArosFprintf(FILE* stream, const char* format, ...) __attribute__((__format__(__printf__, 2, 3)));
+int ffArosVfprintf(FILE* stream, const char* format, va_list ap) __attribute__((__format__(__printf__, 2, 0)));
+int ffArosFflush(FILE* stream);
+
+#ifndef FF_AROS_OUTPUT_IMPL
+    #undef putc
+    #undef putchar
+    #undef fputc
+    #define fwrite(p, s, n, f) ffArosFwrite((p), (s), (n), (f))
+    #define fputs(s, f) ffArosFputs((s), (f))
+    #define fputc(c, f) ffArosPutc((c), (f))
+    #define putc(c, f) ffArosPutc((c), (f))
+    #define putchar(c) ffArosPutc((c), stdout)
+    #define puts(s) ffArosPuts(s)
+    #define printf(...) ffArosPrintf(__VA_ARGS__)
+    #define fprintf(f, ...) ffArosFprintf((f), __VA_ARGS__)
+    #define vprintf(fmt, ap) ffArosVfprintf(stdout, (fmt), (ap))
+    #define vfprintf(f, fmt, ap) ffArosVfprintf((f), (fmt), (ap))
+    #define fflush(f) ffArosFflush(f)
+#endif
diff --git a/src/common/aros/aros_sleep.c b/src/common/aros/aros_sleep.c
new file mode 100644
index 0000000..dbcd02f
--- /dev/null
+++ b/src/common/aros/aros_sleep.c
@@ -0,0 +1,17 @@
+#include "aros_sleep.h"
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <dos/dos.h>
+
+bool ffArosSleep(uint32_t msec) {
+    // Delay() counts ticks of 1/50 s; one at a time, so that Ctrl-C ends
+    // the wait within a tick.
+    for (uint32_t ticks = (msec + 19) / 20; ticks > 0; --ticks) {
+        if (SetSignal(0, SIGBREAKF_CTRL_C) & SIGBREAKF_CTRL_C) {
+            return false;
+        }
+        Delay(1);
+    }
+    return !(SetSignal(0, SIGBREAKF_CTRL_C) & SIGBREAKF_CTRL_C);
+}
diff --git a/src/common/aros/aros_sleep.h b/src/common/aros/aros_sleep.h
