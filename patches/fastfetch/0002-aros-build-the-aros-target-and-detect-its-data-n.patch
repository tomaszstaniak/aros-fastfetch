diff --git a/src/detection/processes/processes_aros.c b/src/detection/processes/processes_aros.c
new file mode 100644
index 0000000..6f3c3e6
--- /dev/null
+++ b/src/detection/processes/processes_aros.c
@@ -0,0 +1,21 @@
+#include "processes.h"
+
+#include <proto/exec.h>
+#include <exec/execbase.h>
+
+const char* ffDetectProcesses([[maybe_unused]] const FFProcessesOptions* options, FFProcessesResult* result) {
+    // Every exec task, processes and plain tasks alike: AROS has no
+    // separate threads. This one is running, so it is on neither list.
+    uint32_t count = 1;
+    Forbid();
+    for (struct Node* n = SysBase->TaskReady.lh_Head; n->ln_Succ; n = n->ln_Succ) {
+        ++count;
+    }
+    for (struct Node* n = SysBase->TaskWait.lh_Head; n->ln_Succ; n = n->ln_Succ) {
+        ++count;
+    }
+    Permit();
+    result->processes = count;
+    result->threads = 0;
+    return nullptr;
+}
