diff --git a/src/common/aros/aros_text.h b/src/common/aros/aros_text.h
index 1fc027b..bd5d23c 100644
--- a/src/common/aros/aros_text.h
+++ b/src/common/aros/aros_text.h
@@ -1,32 +1,84 @@
