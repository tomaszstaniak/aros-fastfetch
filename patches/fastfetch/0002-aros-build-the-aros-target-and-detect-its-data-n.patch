+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// Sleep for msec; false when Ctrl-C arrived meanwhile (the signal is taken).
+// On AROS Ctrl-C is the task's SIGBREAKF_CTRL_C, not a POSIX SIGINT, so the
+// handler fastfetch installs for SIGINT never runs.
+bool ffArosSleep(uint32_t msec);
diff --git a/src/common/aros/aros_terminal.c b/src/common/aros/aros_terminal.c
new file mode 100644
index 0000000..f0f956c
--- /dev/null
+++ b/src/common/aros/aros_terminal.c
@@ -0,0 +1,86 @@
+// The real fflush: this file runs before the first write and must not
+// recurse into the output filter.
+#undef fflush
+#include "aros_terminal.h"
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <dos/dosextens.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct {
+    bool asked;
+    bool answered;
+    bool named;
+    LimpetPresentation presentation;
+    LimpetIdentity identity;
+    char handler[64];
+} state;
+
+static void ask(void) {
+    if (state.asked) {
+        return;
+    }
+    state.asked = true;
+    BPTR output = Output();
+    if (!output) {
+        return;
+    }
+    // The packet is not ordered behind text still in stdio's buffer.
+    fflush(stdout);
+    state.answered = limpet_query_presentation(output, &state.presentation, nullptr) == LIMPET_OK;
+    if (state.answered) {
+        state.named = limpet_query_identity(output, &state.identity, nullptr) == LIMPET_OK &&
+                      (state.identity.known & XTY_IDENTITY_KNOWN_NAME);
+    }
+    if (IsInteractive(output)) {
+        struct FileHandle* fh = BADDR(output);
+        struct MsgPort* port = fh->fh_Type;
+        Forbid();
+        if (port && (port->mp_Flags & PF_ACTION) == PA_SIGNAL && port->mp_SigTask &&
+            ((struct Task*) port->mp_SigTask)->tc_Node.ln_Name) {
+            const char* name = ((struct Task*) port->mp_SigTask)->tc_Node.ln_Name;
+            strncpy(state.handler, name, sizeof(state.handler) - 1);
+        }
+        Permit();
+    }
+}
+
+const LimpetPresentation* ffArosTerminalPresentation(void) {
+    ask();
+    return state.answered ? &state.presentation : nullptr;
+}
+
+bool ffArosTerminalPlain(void) {
+    ask();
+    return !state.answered || limpet_color_level(&state.presentation) < XTY_COLOR_ANSI16;
+}
+
+bool ffArosTerminalUtf8(void) {
+    ask();
+    return state.answered && limpet_text_utf8(&state.presentation);
+}
+
+bool ffArosTerminalLatin1(void) {
+    ask();
+    if (!state.answered) {
+        return state.handler[0] != 0;
+    }
+    return (state.presentation.known & XTY_PRESENT_KNOWN_TEXT) && !limpet_text_utf8(&state.presentation);
+}
+
+bool ffArosTerminalPens(void) {
+    ask();
+    return state.answered && limpet_uses_pens(&state.presentation);
+}
+
+const LimpetIdentity* ffArosTerminalIdentity(void) {
+    ask();
+    return state.named ? &state.identity : nullptr;
+}
+
+const char* ffArosTerminalHandlerTask(void) {
+    ask();
+    return state.handler;
+}
diff --git a/src/common/aros/aros_terminal.h b/src/common/aros/aros_terminal.h
new file mode 100644
index 0000000..6902f5c
--- /dev/null
+++ b/src/common/aros/aros_terminal.h
@@ -0,0 +1,32 @@
+#pragma once
+
+// What the console behind the output says it renders, asked once through
+// the Limpet SDK's presentation query on the actual output FileHandle
+// (Output()), never inferred from a terminal's name or from environment
+// variables, which a child of one console inherits into another.
+
+#include <limpet/limpet.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+// The decoded reply, or nullptr when the console answered nothing (CON:,
+// another console, a file or a pipe): then nothing is known about it.
+const LimpetPresentation* ffArosTerminalPresentation(void);
+// Plain text without any escape sequence: the console did not confirm
+// colours, or the output is not a console.
+bool ffArosTerminalPlain(void);
+// The console confirmed UTF-8 decoding.
+bool ffArosTerminalUtf8(void);
+// Text for this console must be ISO-8859-1: an interactive console that did
+// not answer the query (CON: and other Amiga consoles draw each byte from a
+// Latin-1 font), or one that said it does not decode UTF-8. A terminal that
+// answered without the text bits (Limpet before 0.8.0) is not known to lack
+// UTF-8 and is written UTF-8, as is anything that is not a console.
+bool ffArosTerminalLatin1(void);
+// SGR 30..37/40..47 select Amiga screen pens there (XTY_COLOR_PENS).
+bool ffArosTerminalPens(void);
+// The terminal's name and version (operation 14), or nullptr.
+const LimpetIdentity* ffArosTerminalIdentity(void);
+// Name of the task that handles the output's console, e.g. "CON"; "" if
+// the output is not a console. Not a capability: for the Terminal module.
+const char* ffArosTerminalHandlerTask(void);
diff --git a/src/common/aros/aros_version.c b/src/common/aros/aros_version.c
new file mode 100644
index 0000000..2ece21f
--- /dev/null
+++ b/src/common/aros/aros_version.c
@@ -0,0 +1,72 @@
+#include "aros_version.h"
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <dos/dosextens.h>
+#include <string.h>
+
+static bool isDigit(char c) {
+    return c >= '0' && c <= '9';
+}
+
+bool ffArosParseVersion(const char* text, size_t length, FFstrbuf* version) {
+    const char* p = text;
+    const char* end = text + length;
+    while (p < end && *p != '\0' && *p != '\n' && *p != '\r' && *p != '(') {
+        while (p < end && *p == ' ') {
+            ++p;
+        }
+        const char* word = p;
+        while (p < end && *p != ' ' && *p != '\0' && *p != '\n' && *p != '\r' && *p != '(') {
+            ++p;
+        }
+        // "1.2" or "41": digits and dots only, starting with a digit.
+        const char* q = word;
+        while (q < p && (isDigit(*q) || *q == '.')) {
+            ++q;
+        }
+        if (q == p && p > word && isDigit(*word)) {
+            while (p > word && p[-1] == '.') {
+                --p;
+            }
+            ffStrbufSetNS(version, (uint32_t) (p - word), word);
+            return true;
+        }
+    }
+    return false;
+}
+
+bool ffArosFileVersion(const char* path, FFstrbuf* version) {
+    struct Process* me = (struct Process*) FindTask(nullptr);
+    APTR window = me->pr_WindowPtr;
+    me->pr_WindowPtr = (APTR) -1; // no "insert volume" requester
+    BPTR file = Open((CONST_STRPTR) path, MODE_OLDFILE);
+    me->pr_WindowPtr = window;
+    if (!file) {
+        return false;
+    }
+    enum { KEEP = 128 };
+    static char buffer[8192 + KEEP];
+    size_t kept = 0;
+    bool found = false;
+    for (LONG total = 0; !found && total < (1 << 20);) {
+        LONG n = Read(file, buffer + kept, (LONG) (sizeof(buffer) - kept));
+        bool last = n <= 0;
+        size_t length = kept + (last ? 0 : (size_t) n);
+        total += last ? 0 : n;
+        for (size_t i = 0; i + 5 <= length && !found; ++i) {
+            // A string cut by the end of this read is parsed from the kept
+            // tail after the next one; at the end of the file it is whole.
+            if (memcmp(buffer + i, "$VER:", 5) == 0 && (last || length - i >= KEEP)) {
+                found = ffArosParseVersion(buffer + i + 5, length - i - 5, version);
+            }
+        }
+        if (last) {
+            break;
+        }
+        kept = length < KEEP ? length : KEEP;
+        memmove(buffer, buffer + length - kept, kept);
+    }
+    Close(file);
+    return found;
+}
diff --git a/src/common/aros/aros_version.h b/src/common/aros/aros_version.h
