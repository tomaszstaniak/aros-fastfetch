diff --git a/src/common/impl/processing_aros.c b/src/common/impl/processing_aros.c
new file mode 100644
index 0000000..4df01ff
--- /dev/null
+++ b/src/common/impl/processing_aros.c
@@ -0,0 +1,105 @@
+#include "common/processing.h"
+#include "common/io.h"
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <dos/dostags.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+// AROS has no fork, pipes between C programs or posix_spawn. A command runs
+// to completion through SystemTags with its output in a file in T:, which
+// ffProcessReadOutput reads and deletes. pid carries the return code.
+
+static bool appendQuoted(char* line, size_t size, size_t* length, const char* arg) {
+    // AROS Shell quoting: "..." with *" for a quote and ** for a star.
+    if (*length + 3 >= size) {
+        return false;
+    }
+    line[(*length)++] = '"';
+    for (const char* p = arg; *p; ++p) {
+        if (*length + 4 >= size) {
+            return false;
+        }
+        if (*p == '"' || *p == '*') {
+            line[(*length)++] = '*';
+        } else if (*p == '\n') {
+            return false;
+        }
+        line[(*length)++] = *p;
+    }
+    line[(*length)++] = '"';
+    line[(*length)++] = ' ';
+    line[*length] = '\0';
+    return true;
+}
+
+const char* ffProcessSpawn(char* const argv[], FFProcessOutputType useOutput, [[maybe_unused]] FFNativeFD stdinFd, FFProcessHandle* outHandle) {
+    char line[2048] = "";
+    size_t length = 0;
+    // The program name is not quoted: the Shell looks it up in its path.
+    if (!argv[0] || strlen(argv[0]) + 2 >= sizeof(line)) {
+        return "Command is too long";
+    }
+    length = (size_t) snprintf(line, sizeof(line), "%s ", argv[0]);
+    for (unsigned i = 1; argv[i]; ++i) {
+        if (!appendQuoted(line, sizeof(line), &length, argv[i])) {
+            return "Command is too long or contains a line feed";
+        }
+    }
+
+    char path[64];
+    snprintf(path, sizeof(path), "T:fastfetch-%p.out", (void*) FindTask(nullptr));
+    BPTR output = Open((CONST_STRPTR) path, MODE_NEWFILE);
+    if (!output) {
+        return "Cannot create the command's output file in T:";
+    }
+    BPTR input = Open((CONST_STRPTR) "NIL:", MODE_OLDFILE);
+    // Without the stdout bit the command's output goes to NIL:; AROS
+    // programs write errors to the same handle, so stderr follows stdout.
+    BPTR target = output;
+    BPTR nil = 0;
+    if (!(useOutput & FF_PROCESS_OUTPUT_STDOUT_BIT)) {
+        nil = Open((CONST_STRPTR) "NIL:", MODE_NEWFILE);
+        target = nil;
+    }
+    LONG rc = SystemTags((CONST_STRPTR) line, SYS_Input, (IPTR) input, SYS_Output, (IPTR) target,
+                         NP_StackSize, 65536, TAG_DONE);
+    if (rc == -1) {
+        // The handles were not taken over by a new process.
+        if (input) {
+            Close(input);
+        }
+        if (nil) {
+            Close(nil);
+        }
+        Close(output);
+        DeleteFile((CONST_STRPTR) path);
+        return "SystemTags() failed";
+    }
+    if (nil) {
+        Close(output);
+    }
+    outHandle->pid = (pid_t) rc;
+    outHandle->pipeRead = open(path, O_RDONLY);
+    DeleteFile((CONST_STRPTR) path); // the open descriptor keeps it readable on RAM: and SFS
+    if (outHandle->pipeRead < 0) {
+        return "Cannot read the command's output";
+    }
+    return nullptr;
+}
+
+const char* ffProcessReadOutput(FFProcessHandle* handle, FFstrbuf* buffer) {
+    bool ok = ffAppendFDBuffer(handle->pipeRead, buffer);
+    close(handle->pipeRead);
+    handle->pipeRead = -1;
+    if (!ok) {
+        return "Reading the command's output failed";
+    }
+    if (handle->pid != 0) {
+        return "The command failed";
+    }
+    return nullptr;
+}
