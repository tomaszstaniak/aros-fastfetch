+// digits and dots, before the date in parentheses. The name may be absent,
+// contain spaces or be preceded by more than one space ("$VER:  Wanderer
+// 1.7", mainline and AROS One). Sets version to "1.2".
+bool ffArosParseVersion(const char* text, size_t length, FFstrbuf* version);
+// The same, read from a program file's "$VER: " string (the first 1 MiB
+// at most), never by running it: "name --version" would start the program.
+bool ffArosFileVersion(const char* path, FFstrbuf* version);
