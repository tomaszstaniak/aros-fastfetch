+#include "common/strutil.h"
+
+#include <proto/exec.h>
+#include <proto/intuition.h>
+#include <proto/graphics.h>
+#include <exec/execbase.h>
+#include <graphics/displayinfo.h>
+#include <intuition/intuitionbase.h>
+#include <intuition/screens.h>
+#include <string.h>
+
+// Wanderer runs as a CLI process named after its command, for example
+// "WANDERER:Wanderer" on AROS One 1.3 and mainline; FindTask("Wanderer")
+// finds nothing there. The last component of a task's name is compared.
+static bool taskRunning(const char* program) {
+    bool found = false;
+    Forbid();
+    struct List* lists[] = { &SysBase->TaskReady, &SysBase->TaskWait };
+    for (unsigned i = 0; i < 2 && !found; ++i) {
+        for (struct Node* n = lists[i]->lh_Head; n->ln_Succ && !found; n = n->ln_Succ) {
+            const char* name = n->ln_Name;
+            if (!name) {
+                continue;
+            }
+            const char* last = name;
+            for (const char* p = name; *p; ++p) {
+                if (*p == ':' || *p == '/') {
+                    last = p + 1;
+                }
+            }
+            found = ffStrEquals(last, program);
+        }
+    }
+    Permit();
+    return found;
+}
+
+void ffConnectDisplayServerImpl(FFDisplayServerResult* ds) {
+    // Windows are managed by intuition.library itself.
+    ffStrbufSetStatic(&ds->wmProcessName, "intuition.library");
+    ffStrbufSetF(&ds->wmPrettyName, "Intuition %u.%u", (unsigned) IntuitionBase->LibNode.lib_Version,
+                 (unsigned) IntuitionBase->LibNode.lib_Revision);
+    if (taskRunning("Wanderer")) {
+        ffStrbufSetStatic(&ds->deProcessName, "Wanderer");
+        // Its version is the DE module's (de_aros.c).
+        ffStrbufSetStatic(&ds->dePrettyName, "Wanderer");
+    }
+
+    // The default public screen (Workbench): what the user sees.
+    struct Screen* screen = LockPubScreen(nullptr);
+    if (!screen) {
+        return;
+    }
+    ULONG mode = GetVPModeID(&screen->ViewPort);
+    FF_STRBUF_AUTO_DESTROY name = ffStrbufCreate();
+    struct NameInfo info;
+    if (mode != (ULONG) INVALID_ID && GetDisplayInfoData(nullptr, (UBYTE*) &info, sizeof(info), DTAG_NAME, mode)) {
+        ffStrbufSetS(&name, (const char*) info.Name);
+    }
+    FFDisplayResult* display = ffdsAppendDisplay(ds, (uint32_t) screen->Width, (uint32_t) screen->Height, 0, 0, 0, 0, 0, 0,
+                                                 &name, FF_DISPLAY_TYPE_UNKNOWN, true, mode, 0, 0, "graphics.library");
+    if (display) {
+        display->bitDepth = (uint8_t) GetBitMapAttr(screen->RastPort.BitMap, BMA_DEPTH);
+    }
+    UnlockPubScreen(nullptr, screen);
+}
