 doc/json_schema.json              | 232 ++++++++++++++++++++++++++++++
 src/common/impl/jsonconfig.c      |  16 ++-
 src/modules/break/break.c         |   2 +-
 src/modules/logo/logo.c           |   2 +-
 src/modules/separator/separator.c |   2 +-
 src/modules/users/users.c         |   2 +-
 7 files changed, 252 insertions(+), 6 deletions(-)

