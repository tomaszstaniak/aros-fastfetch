+#include "cpu.h"
+#include "common/strutil.h"
+
+#include <proto/exec.h>
+#include <proto/processor.h>
+#include <resources/processor.h>
+
+const char* ffDetectCPUImpl([[maybe_unused]] const FFCPUOptions* options, FFCPUResult* cpu) {
+    APTR ProcessorBase = OpenResource((CONST_STRPTR) PROCESSORNAME);
+    if (!ProcessorBase) {
+        return "processor.resource is unavailable";
+    }
+    ULONG count = 0;
+    CONST_STRPTR model = nullptr;
+    UQUAD speed = 0;
+    GetCPUInfoTags(GCIT_NumberOfProcessors, (IPTR) &count, TAG_DONE);
+    GetCPUInfoTags(GCIT_SelectedProcessor, 0, GCIT_ModelString, (IPTR) &model,
+                   GCIT_ProcessorSpeed, (IPTR) &speed, TAG_DONE);
+    // processor.resource says "Unknown" when it cannot name the CPU (the
+    // Pi system of 2026-08-22): that is no name, not a model called so.
+    if (!model || !*model || ffStrEqualsIgnCase((const char*) model, "Unknown")) {
+        return "processor.resource does not name this processor";
+    }
+    ffStrbufSetS(&cpu->name, (const char*) model);
+    // Processors the system found; whether exec schedules on all of them
+    // (an SMP build) is not reported here.
+    cpu->coresPhysical = cpu->coresLogical = cpu->coresOnline = (uint16_t) count;
+    cpu->packages = count ? 1 : 0;
+    if (speed) {
+        cpu->frequencyBase = (uint32_t) (speed / 1000000);
+    }
+#if __x86_64__
+    ffCPUDetectByCpuid(cpu); // base and maximum clock where CPUID reports them
+#endif
+    return nullptr;
+}
