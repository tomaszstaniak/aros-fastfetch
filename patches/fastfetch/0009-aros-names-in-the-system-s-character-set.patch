+// AROS names (volumes, fonts, locales, tasks, screen modes, drawers) are
+// bytes in the system's character set (aros_charset.h), and fastfetch
+// keeps UTF-8: its output filter and the JSON writer read every string as
+// UTF-8, so a raw "Größe:" would come out as "Gr??e" in CON: and make the
+// JSON invalid. These convert for display and JSON only; a name that goes
+// back to DOS is kept as the bytes DOS gave.
+static inline void ffArosStrbufAppendScalar(FFstrbuf* out, uint32_t c) {
+    if (c < 0x80) {
+        ffStrbufAppendC(out, (char) c);
+    } else if (c < 0x800) {
+        ffStrbufAppendC(out, (char) (0xC0 | (c >> 6)));
+        ffStrbufAppendC(out, (char) (0x80 | (c & 0x3F)));
+    } else if (c < 0x10000) {
+        ffStrbufAppendC(out, (char) (0xE0 | (c >> 12)));
+        ffStrbufAppendC(out, (char) (0x80 | ((c >> 6) & 0x3F)));
+        ffStrbufAppendC(out, (char) (0x80 | (c & 0x3F)));
+    } else {
+        ffStrbufAppendC(out, (char) (0xF0 | (c >> 18)));
+        ffStrbufAppendC(out, (char) (0x80 | ((c >> 12) & 0x3F)));
+        ffStrbufAppendC(out, (char) (0x80 | ((c >> 6) & 0x3F)));
+        ffStrbufAppendC(out, (char) (0x80 | (c & 0x3F)));
+    }
+}
+
+// Length of a well-formed UTF-8 sequence at text (at most `left` bytes), or 0.
+static inline size_t ffArosUtf8Length(const unsigned char* text, size_t left) {
+    unsigned char c = text[0];
+    size_t n = c >= 0xF0 && c <= 0xF4 ? 4 : c >= 0xE0 ? 3 : c >= 0xC2 && c < 0xE0 ? 2 : 0;
+    if (!n || n > left || c > 0xF4) {
+        return 0;
+    }
+    uint32_t scalar = c & (0x7F >> n);
+    for (size_t i = 1; i < n; ++i) {
+        if ((text[i] & 0xC0) != 0x80) {
+            return 0;
+        }
+        scalar = (scalar << 6) | (text[i] & 0x3F);
+    }
+    if ((n == 3 && (scalar < 0x800 || (scalar >= 0xD800 && scalar <= 0xDFFF))) || (n == 4 && (scalar < 0x10000 || scalar > 0x10FFFF))) {
+        return 0;
+    }
+    return n;
+}
+
+static inline void ffArosStrbufAppendNativeN(FFstrbuf* out, const char* text, size_t length) {
+    const FFArosCharset* set = ffArosCharset();
+    const unsigned char* bytes = (const unsigned char*) text;
+    for (size_t i = 0; i < length;) {
+        unsigned char c = bytes[i];
         if (c < 0x80) {
             ffStrbufAppendC(out, (char) c);
+            ++i;
+        } else if (set->utf8) {
+            size_t n = ffArosUtf8Length(bytes + i, length - i);
+            if (n) {
+                ffStrbufAppendNS(out, (uint32_t) n, text + i);
+                i += n;
+            } else {
+                ffArosStrbufAppendScalar(out, 0xFFFD);
+                ++i;
+            }
         } else {
-            ffStrbufAppendC(out, (char) (0xC0 | (c >> 6)));
-            ffStrbufAppendC(out, (char) (0x80 | (c & 0x3F)));
+            uint32_t scalar = set->high[c - 0x80];
+            ffArosStrbufAppendScalar(out, scalar ? scalar : 0xFFFD);
+            ++i;
         }
     }
 }
 
-static inline void ffArosStrbufSetLatin1(FFstrbuf* out, const char* text) {
-    ffArosStrbufSetLatin1N(out, text, strlen(text));
+static inline void ffArosStrbufSetNativeN(FFstrbuf* out, const char* text, size_t length) {
+    ffStrbufClear(out);
+    ffArosStrbufAppendNativeN(out, text, length);
 }
 
-static inline void ffArosStrbufAppendLatin1N(FFstrbuf* out, const char* text, size_t length) {
-    FF_STRBUF_AUTO_DESTROY part = ffStrbufCreate();
-    ffArosStrbufSetLatin1N(&part, text, length);
-    ffStrbufAppend(out, &part);
+static inline void ffArosStrbufSetNative(FFstrbuf* out, const char* text) {
+    ffArosStrbufSetNativeN(out, text, strlen(text));
 }
