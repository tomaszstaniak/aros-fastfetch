diff --git a/src/logo/image/image_aros.c b/src/logo/image/image_aros.c
new file mode 100644
index 0000000..46a240e
--- /dev/null
+++ b/src/logo/image/image_aros.c
@@ -0,0 +1,270 @@
+// Image logos on AROS: kitty and kitty-direct, both drawn the same way.
+// The picture is decoded by the system's datatypes (any format a
+// picture datatype reads: PNG, IFF ILBM, JPEG, ...), scaled here to whole
+// text cells, and sent as raw RGBA through the Kitty graphics subset with
+// the Limpet SDK's encoder. Upstream's kitty-direct hands the terminal a
+// PNG file name (f=100,t=f); Limpet reads neither PNG nor files, and needs
+// no file access for a logo.
+//
+// Nothing is sent unless the terminal confirmed the subset
+// (XTY_FEATURE_KITTY_GRAPHICS) and reported its cell size in pixels
+// (ACTION_CONSOLE_GETGEOMETRY): CON: would print the base64 as text. The
+// caller falls back to a text logo when this returns false.
+#include "image.h"
+#include "common/aros/aros_terminal.h"
+#include "common/printing.h"
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+// Opened only while a picture is drawn: a program-wide base would make
+// datatypes.library a condition of starting at all.
+#define __DATATYPES_NOLIBBASE__
+#include <proto/datatypes.h>
+#include <dos/dosextens.h>
+#include <datatypes/pictureclass.h>
+#include <clib/alib_protos.h>
+#include <limpet/limpet.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// An id of our own: drawing again replaces the previous fastfetch logo
+// (--dynamic-interval) instead of filling the terminal's 16 image slots.
+#define FF_AROS_LOGO_IMAGE_ID 0x46466c67u // "FFlg"
+// Columns when neither --logo-width nor --logo-height is given.
+#define FF_AROS_LOGO_DEFAULT_COLUMNS 28u
+
+typedef struct {
+    uint8_t* rgba;
+    uint32_t width, height;
+} Picture;
+
+static struct Library* DataTypesBase;
+
+static const char* loadPicture(const char* path, Picture* out) {
+    struct Process* self = (struct Process*) FindTask(nullptr);
+    APTR window = self->pr_WindowPtr;
+    self->pr_WindowPtr = (APTR) -1; // no "insert volume" requester
+    Object* o = NewDTObject((APTR) path, DTA_GroupID, GID_PICTURE, PDTA_DestMode, PMODE_V43, PDTA_Remap, FALSE, TAG_DONE);
+    self->pr_WindowPtr = window;
+    if (!o) {
+        return "No picture datatype could read the file";
+    }
+    const char* error = nullptr;
+    struct BitMapHeader* bmh = nullptr;
+    if (GetDTAttrs(o, PDTA_BitMapHeader, (IPTR) &bmh, TAG_DONE) != 1 || !bmh || !bmh->bmh_Width || !bmh->bmh_Height) {
+        error = "The picture has no size";
+    } else if (bmh->bmh_Width > 4096 || bmh->bmh_Height > 4096) {
+        error = "The picture is larger than 4096x4096";
+    } else {
+        out->width = bmh->bmh_Width;
+        out->height = bmh->bmh_Height;
+        out->rgba = malloc((size_t) out->width * out->height * 4);
+        if (!out->rgba) {
+            error = "Not enough memory for the picture";
+        } else {
+            struct pdtBlitPixelArray read = {
+                .MethodID = PDTM_READPIXELARRAY,
+                .pbpa_PixelData = out->rgba,
+                .pbpa_PixelFormat = PBPAFMT_RGBA,
+                .pbpa_PixelArrayMod = out->width * 4,
+                .pbpa_Left = 0,
+                .pbpa_Top = 0,
+                .pbpa_Width = out->width,
+                .pbpa_Height = out->height,
+            };
+            // DoMethodA, not DoDTMethodA: that goes through intuition's
+            // DoGadgetMethodA, which holds its GadgetLock for the whole
+            // method, and the conversion behind PDTM_READPIXELARRAY then
+            // stopped all input on mainline (2026-10-27; the machine had to
+            // be powered off). An object on no window needs no GadgetInfo.
+            if (!DoMethodA(o, (Msg) &read)) {
+                free(out->rgba);
+                out->rgba = nullptr;
+                error = "The datatype could not deliver the pixels";
+            } else if (bmh->bmh_Masking != mskHasAlpha) {
+                // A picture without an alpha channel read as RGBA came back
+                // with alpha 0 (mainline, a PNG without alpha): opaque, then.
+                for (size_t i = 3; i < (size_t) out->width * out->height * 4; i += 4) {
+                    out->rgba[i] = 0xff;
+                }
+            }
+        }
+    }
+    DisposeDTObject(o);
+    return error;
+}
+
+// Area-average scaling of `in` into a box of boxW x boxH, keeping the
+// aspect ratio and centring; the rest of the box stays transparent.
+// Colours are averaged weighted by alpha, so transparent pixels do not
+// darken the edges.
+static void scaleInto(const Picture* in, uint8_t* box, uint32_t boxW, uint32_t boxH) {
+    memset(box, 0, (size_t) boxW * boxH * 4);
+    uint32_t w = boxW, h = (uint32_t) ((uint64_t) in->height * boxW / in->width);
+    if (h > boxH) {
+        h = boxH;
+        w = (uint32_t) ((uint64_t) in->width * boxH / in->height);
+    }
+    // A picture far wider (or taller) than the box still gets a line.
+    if (!w) {
+        w = 1;
+    }
+    if (!h) {
+        h = 1;
+    }
+    uint32_t offX = (boxW - w) / 2, offY = (boxH - h) / 2;
+    for (uint32_t y = 0; y < h; ++y) {
+        uint32_t sy0 = (uint32_t) ((uint64_t) y * in->height / h);
+        uint32_t sy1 = (uint32_t) ((uint64_t) (y + 1) * in->height / h);
+        if (sy1 <= sy0) {
+            sy1 = sy0 + 1;
+        }
+        for (uint32_t x = 0; x < w; ++x) {
+            uint32_t sx0 = (uint32_t) ((uint64_t) x * in->width / w);
+            uint32_t sx1 = (uint32_t) ((uint64_t) (x + 1) * in->width / w);
+            if (sx1 <= sx0) {
+                sx1 = sx0 + 1;
+            }
+            uint64_t r = 0, g = 0, b = 0, a = 0, n = 0;
+            for (uint32_t sy = sy0; sy < sy1 && sy < in->height; ++sy) {
+                const uint8_t* p = in->rgba + ((size_t) sy * in->width + sx0) * 4;
+                for (uint32_t sx = sx0; sx < sx1 && sx < in->width; ++sx, p += 4) {
+                    r += (uint64_t) p[0] * p[3];
+                    g += (uint64_t) p[1] * p[3];
+                    b += (uint64_t) p[2] * p[3];
+                    a += p[3];
+                    ++n;
+                }
+            }
+            uint8_t* d = box + ((size_t) (y + offY) * boxW + x + offX) * 4;
+            if (a) {
+                d[0] = (uint8_t) (r / a);
+                d[1] = (uint8_t) (g / a);
+                d[2] = (uint8_t) (b / a);
+            }
+            d[3] = (uint8_t) (n ? a / n : 0);
+        }
+    }
+}
+
+static int writeStdout(void* context, const char* bytes, size_t length) {
+    (void) context;
+    return fwrite(bytes, 1, length, stdout) != length;
+}
+
+static bool fail(bool printError, const char* error) {
+    if (printError) {
+        fprintf(stderr, "Logo (kitty on AROS): %s\n", error);
+    }
+    return false;
+}
+
+bool ffLogoPrintImageIfExists(FFLogoType type, bool printError) {
+    FFOptionsLogo* options = &instance.config.logo;
+
+    if (type != FF_LOGO_TYPE_IMAGE_KITTY && type != FF_LOGO_TYPE_IMAGE_KITTY_DIRECT) {
+        return fail(printError, "only the kitty and kitty-direct types are available on AROS");
+    }
+    if (instance.config.display.pipe) {
+        return fail(printError, "no image in pipe mode (redirected output, or a console without colours)");
+    }
+    if (!limpet_has_kitty_graphics(ffArosTerminalPresentation())) {
+        return fail(printError, "the terminal does not confirm Kitty graphics (Limpet 0.8.0 does)");
+    }
+    LimpetGeometry geometry;
+    if (limpet_query_geometry(Output(), &geometry, nullptr) != LIMPET_OK || !geometry.width || !geometry.height) {
+        return fail(printError, "the terminal does not report its cell size in pixels");
+    }
+    uint32_t cellW = geometry.width / geometry.columns, cellH = geometry.height / geometry.rows;
+    if (!cellW || !cellH) {
+        return fail(printError, "the terminal reports an empty cell");
+    }
+
+    Picture picture = {};
+    DataTypesBase = OpenLibrary((CONST_STRPTR) "datatypes.library", 39);
+    if (!DataTypesBase) {
+        return fail(printError, "datatypes.library is not available");
+    }
+    const char* error = loadPicture(options->source.chars, &picture);
+    CloseLibrary(DataTypesBase);
+    DataTypesBase = nullptr;
+    if (error) {
+        return fail(printError, error);
+    }
+
+    // Cells: what was asked, else the width with the height from the
+    // picture's aspect ratio (rounded to whole rows).
+    uint32_t columns = options->width, rows = options->height;
+    if (!columns && rows) {
+        columns = (uint32_t) (((uint64_t) rows * cellH * picture.width / picture.height + cellW / 2) / cellW);
+    }
+    if (!columns) {
+        columns = FF_AROS_LOGO_DEFAULT_COLUMNS;
+    }
+    if (!rows) {
+        rows = (uint32_t) (((uint64_t) columns * cellW * picture.height / picture.width + cellH / 2) / cellH);
+    }
+    if (!columns || !rows) {
+        columns = rows = 1;
+    }
+    // Limpet's limits: 1024 pixels a side, 4 MiB per image.
+    while ((uint64_t) columns * cellW > LIMPET_KITTY_MAX_SIDE || (uint64_t) rows * cellH > LIMPET_KITTY_MAX_SIDE ||
+           (uint64_t) columns * cellW * rows * cellH * 4 > LIMPET_KITTY_MAX_BYTES) {
+        if (columns > 1) {
+            --columns;
+        }
+        if (rows > 1) {
+            --rows;
+        }
+        if (columns == 1 && rows == 1) {
+            break;
+        }
+    }
+
+    ffLogoResolveAutoPosition(columns + options->paddingLeft + options->paddingRight);
+    if (options->position == FF_LOGO_POSITION_RIGHT) {
+        free(picture.rgba);
+        return fail(printError, "position right is not available for images on AROS");
+    }
+
+    LimpetImage image = {
+        .id = FF_AROS_LOGO_IMAGE_ID,
+        .width = columns * cellW,
+        .height = rows * cellH,
+        .format = 32,
+        .keep_cursor = 0, // the cursor ends on the image's last row; it scrolls into view first
+        .quiet = 2,       // no reply: it would arrive as input
+    };
+    uint8_t* box = malloc((size_t) image.width * image.height * 4);
+    if (!box) {
+        free(picture.rgba);
+        return fail(printError, "not enough memory for the scaled picture");
+    }
+    scaleInto(&picture, box, image.width, image.height);
+    free(picture.rgba);
+
+    // The layout of upstream's kitty-direct with a known size: padding,
+    // the image, a line feed under it, then back up to the logo's first
+    // row, where the module lines start.
+    ffPrintCharTimes('\n', options->paddingTop);
+    if (options->paddingLeft) {
+        printf("\033[%uC", (unsigned) options->paddingLeft);
+    }
+    fflush(stdout);
+    int rc = limpet_kitty_transmit(&image, box, writeStdout, nullptr);
+    free(box);
+    if (rc) {
+        return fail(printError, "writing the image failed");
+    }
+    putchar('\n');
+    if (options->position == FF_LOGO_POSITION_LEFT) {
+        instance.state.logoWidth = columns + options->paddingLeft + options->paddingRight;
+        instance.state.logoHeight = options->paddingTop + rows;
+        printf("\033[%uA", (unsigned) instance.state.logoHeight);
+    } else { // top
+        instance.state.logoWidth = instance.state.logoHeight = 0;
+        ffPrintCharTimes('\n', options->paddingRight);
+    }
+    return true;
+}
