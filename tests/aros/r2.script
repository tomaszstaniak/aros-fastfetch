.KEY BIN/A,OUT/A,CMD/A
.BRA {
.KET }
; Guest checks of the changes in 2.70.0-r2, after smoke.script:
;   Execute r2.script BIN=fastfetch OUT=RESULTS:<run directory> CMD=RAM:ff/r2-command.jsonc
; This file holds two ISO-8859-2 bytes (0xB1, 0xEA): the RAM: volume is
; renamed "Dysk Бъ" for the character set runs and named "Ram Disk"
; again after them; ENV:CHARSET is set for them and removed again.
FailAt 21
MakeDir {OUT}
; The package's configuration directory comes last.
{BIN} --list-config-paths >{OUT}/r2-config-paths.txt
Echo $RC >{OUT}/r2-config-paths.rc
; CPU cores and the default route, as data.
{BIN} --format json -s CPU:LocalIp >{OUT}/r2-cpu-ip.json
Echo $RC >{OUT}/r2-cpu-ip.rc
{BIN} --format json -s LocalIp --localip-default-route-only false --localip-show-flags true >{OUT}/r2-ip-all.json
Echo $RC >{OUT}/r2-ip-all.rc
; Command module: a program in a drawer with spaces, and three commands
; started before the first is read.
MakeDir "RAM:ff r2"
MakeDir "RAM:ff r2/My Tools"
Copy C:Echo "RAM:ff r2/My Tools/say it" QUIET
{BIN} -c {CMD} >{OUT}/r2-command.txt
Echo $RC >{OUT}/r2-command.rc
Delete "RAM:ff r2" ALL QUIET
List T: PAT=fastfetch#? >{OUT}/r2-t-left.txt
; The picture logo where it cannot be shown: output to a file.
{BIN} -c aros-logo >{OUT}/r2-logo-redirected.txt
Echo $RC >{OUT}/r2-logo-redirected.rc
; Names in the system's character set: ISO-8859-2 and a Polish name.
If EXISTS ENV:CHARSET
  Echo "ENV:CHARSET is set: the user's choice; not changed, no character set runs" >{OUT}/r2-latin2.txt
  Skip charset-done
EndIf
Info RAM: >{OUT}/r2-ram-before.txt
SetEnv CHARSET ISO-8859-2
Avail FLUSH >NIL:
Relabel RAM: "Dysk Бъ"
{BIN} --format json -s Disk >{OUT}/r2-latin2.json
Echo $RC >{OUT}/r2-latin2.rc
{BIN} --logo none -s Disk >{OUT}/r2-latin2.txt
Relabel RAM: "Ram Disk"
UnSetEnv CHARSET
Avail FLUSH >NIL:
Info RAM: >{OUT}/r2-ram-after.txt
{BIN} --format json -s Disk >{OUT}/r2-latin1.json
Echo $RC >{OUT}/r2-latin1.rc
Lab charset-done
Echo "done" >{OUT}/r2-done.txt
Echo "r2 done"
