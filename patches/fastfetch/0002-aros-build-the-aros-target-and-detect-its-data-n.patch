diff --git a/src/detection/uptime/uptime_aros.c b/src/detection/uptime/uptime_aros.c
new file mode 100644
index 0000000..2c8a9f3
--- /dev/null
+++ b/src/detection/uptime/uptime_aros.c
@@ -0,0 +1,29 @@
+#include "uptime.h"
+#include "common/time.h"
+
+#include <proto/exec.h>
+#include <proto/timer.h>
+#include <devices/timer.h>
+
+const char* ffDetectUptime(FFUptimeResult* result) {
+    struct MsgPort* port = CreateMsgPort();
+    if (!port) {
+        return "CreateMsgPort() failed";
+    }
+    struct timerequest* tr = (struct timerequest*) CreateIORequest(port, sizeof(*tr));
+    const char* error = "timer.device is unavailable";
+    if (tr && OpenDevice((CONST_STRPTR) TIMERNAME, UNIT_MICROHZ, (struct IORequest*) tr, 0) == 0) {
+        struct Device* TimerBase = tr->tr_node.io_Device;
+        struct timeval tv = {};
+        GetUpTime(&tv);
+        result->uptime = (uint64_t) tv.tv_secs * 1000 + tv.tv_micro / 1000;
+        result->bootTime = ffTimeGetNow() - result->uptime;
+        error = nullptr;
+        CloseDevice((struct IORequest*) tr);
+    }
+    if (tr) {
+        DeleteIORequest((struct IORequest*) tr);
+    }
+    DeleteMsgPort(port);
+    return error;
+}
