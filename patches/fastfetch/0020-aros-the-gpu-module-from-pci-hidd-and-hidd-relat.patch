--- /dev/null
+++ b/src/common/aros/aros_memmem.h
@@ -0,0 +1,8 @@
+#pragma once
+
+// memmem, a GNU and BSD extension the AROS C libraries do not have. Given
+// to the files that need it (src/detection/gpu/gpu_pci.c) with -include.
+
+#include <stddef.h>
+
+void* memmem(const void* haystack, size_t haystackLength, const void* needle, size_t needleLength);
