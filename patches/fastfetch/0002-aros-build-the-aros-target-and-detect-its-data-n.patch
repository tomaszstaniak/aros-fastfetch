diff --git a/src/detection/disk/disk_aros.c b/src/detection/disk/disk_aros.c
new file mode 100644
index 0000000..0f7756f
--- /dev/null
+++ b/src/detection/disk/disk_aros.c
@@ -0,0 +1,150 @@
+#include "disk.h"
+#include "common/strutil.h"
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <dos/dosextens.h>
+#include <dos/filehandler.h>
+#include <string.h>
+
+typedef struct {
+    char name[108]; // "Volume:"
+    char device[108]; // "DH0:", when found
+    ULONG deviceDosType; // from the device's mount environment, 0 if none
+} VolumeName;
+
+// The DOS type the device was mounted with. Info() answers ID_DOS_DISK
+// ("DOS\0") for FAT and ISO 9660 volumes (fat-handler, cdrom-handler on
+// AROS One 1.3 and mainline); the mount environment names the real one.
+// dol_Startup is not always a FileSysStartupMsg: handlers may keep a small
+// number or a string there, so every pointer is checked to be memory.
+static ULONG deviceDosType(struct DosList* device) {
+    BPTR startup = device->dol_misc.dol_handler.dol_Startup;
+    if ((IPTR) startup < 0x1000) {
+        return 0;
+    }
+    struct FileSysStartupMsg* fssm = BADDR(startup);
+    if (!TypeOfMem(fssm) || !fssm->fssm_Environ) {
+        return 0;
+    }
+    struct DosEnvec* de = BADDR(fssm->fssm_Environ);
+    if (!TypeOfMem(de) || de->de_TableSize < DE_DOSTYPE) {
+        return 0;
+    }
+    return (ULONG) de->de_DosType;
+}
+
+static void bstrCopy(char* out, size_t size, BSTR b) {
+#ifdef AROS_FAST_BSTR
+    size_t n = strlen((const char*) AROS_BSTR_ADDR(b)); // the SDK macro passes a STRPTR to strlen
+#else
+    size_t n = (size_t) AROS_BSTR_strlen(b);
+#endif
+    if (n > size - 2) {
+        n = size - 2;
+    }
+    memcpy(out, AROS_BSTR_ADDR(b), n);
+    out[n] = ':';
+    out[n + 1] = '\0';
+}
+
+// "SFS\0" -> "SFS", "DOS\3" -> "DOS3": the four bytes of the DOS type.
+static void dosType(FFstrbuf* out, ULONG type) {
+    char t[5] = { (char) (type >> 24), (char) (type >> 16), (char) (type >> 8), (char) type, 0 };
+    for (int i = 0; i < 3; ++i) {
+        if ((unsigned char) t[i] < 0x20 || (unsigned char) t[i] > 0x7e) {
+            ffStrbufSetF(out, "0x%08lx", (unsigned long) type);
+            return;
+        }
+    }
+    if ((unsigned char) t[3] < 0x20) {
+        t[3] = (char) ('0' + t[3]);
+    }
+    if (t[3] == '0' && !ffStrEquals(t, "DOS0")) {
+        t[3] = 0;
+    }
+    ffStrbufSetS(out, t);
+}
+
+const char* ffDetectDisksImpl(FFDiskOptions* options, FFlist* disks) {
+    VolumeName names[32];
+    uint32_t count = 0;
+
+    // Volumes in a drive (dol_Task set), and the device each is mounted on.
+    struct DosList* dl = LockDosList(LDF_VOLUMES | LDF_DEVICES | LDF_READ);
+    struct DosList* v = dl;
+    while (count < 32 && (v = NextDosEntry(v, LDF_VOLUMES))) {
+        if (!v->dol_Task) {
+            continue;
+        }
+        VolumeName* n = &names[count++];
+        bstrCopy(n->name, sizeof(n->name), v->dol_Name);
+        n->device[0] = '\0';
+        n->deviceDosType = 0;
+        struct DosList* d = dl;
+        while ((d = NextDosEntry(d, LDF_DEVICES))) {
+            if (d->dol_Task == v->dol_Task) {
+                bstrCopy(n->device, sizeof(n->device), d->dol_Name);
+                n->deviceDosType = deviceDosType(d);
+                break;
+            }
+        }
+    }
+    UnLockDosList(LDF_VOLUMES | LDF_DEVICES | LDF_READ);
+
+    struct Process* me = (struct Process*) FindTask(nullptr);
+    APTR window = me->pr_WindowPtr;
+    me->pr_WindowPtr = (APTR) -1; // a removed disk must not open a requester
+    for (uint32_t i = 0; i < count; ++i) {
+        const char* path = names[i].name;
+        if (options->folders.length && !ffStrbufSeparatedContainS(&options->folders, path, FF_DISK_FOLDER_SEPARATOR)) {
+            continue;
+        }
+        if (options->hideFolders.length && ffDiskMatchesFolderPatterns(&options->hideFolders, path, FF_DISK_FOLDER_SEPARATOR)) {
+            continue;
+        }
+        BPTR lock = Lock((CONST_STRPTR) path, ACCESS_READ);
+        if (!lock) {
+            continue;
+        }
+        struct InfoData id;
+        bool ok = Info(lock, &id);
+        UnLock(lock);
+        if (!ok || id.id_BytesPerBlock <= 0) {
+            continue;
+        }
+        FF_STRBUF_AUTO_DESTROY fs = ffStrbufCreate();
+        ULONG type = (ULONG) id.id_DiskType;
+        if (type == ID_DOS_DISK && names[i].deviceDosType) {
+            type = names[i].deviceDosType;
+        }
+        dosType(&fs, type);
+        if (options->hideFS.length && ffStrbufSeparatedContainS(&options->hideFS, fs.chars, ':')) {
+            continue;
+        }
+
+        FFDisk* disk = FF_LIST_ADD(FFDisk, *disks);
+        uint64_t block = (uint64_t) id.id_BytesPerBlock;
+        uint64_t total = (uint64_t) (ULONG) id.id_NumBlocks;
+        uint64_t used = (uint64_t) (ULONG) id.id_NumBlocksUsed;
+        disk->bytesTotal = total * block;
+        disk->bytesFree = used <= total ? (total - used) * block : 0;
+        disk->filesUsed = 0;
+        disk->filesTotal = 0;
+        disk->createTime = 0;
+        ffStrbufInitS(&disk->mountFrom, names[i].device);
+        ffStrbufInitS(&disk->mountpoint, path);
+        ffStrbufInitMove(&disk->filesystem, &fs);
+        ffStrbufInitNS(&disk->name, (uint32_t) strlen(path) - 1, path);
+        disk->type = FF_DISK_VOLUME_TYPE_REGULAR_BIT;
+        // The RAM disk grows with its contents: its "size" is free memory.
+        if (ffStrEquals(names[i].device, "RAM:")) {
+            disk->type = FF_DISK_VOLUME_TYPE_HIDDEN_BIT;
+        }
+        if (id.id_DiskState == ID_WRITE_PROTECTED) {
+            disk->type |= FF_DISK_VOLUME_TYPE_READONLY_BIT;
+        }
+    }
+    me->pr_WindowPtr = window;
+    return nullptr;
+}
