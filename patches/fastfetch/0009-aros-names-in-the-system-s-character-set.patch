diff --git a/src/common/aros/aros_charset.c b/src/common/aros/aros_charset.c
new file mode 100644
index 0000000..552df29
--- /dev/null
+++ b/src/common/aros/aros_charset.c
@@ -0,0 +1,55 @@
+#include "aros_charset.h"
+
+#include <proto/exec.h>
+#include <proto/codesets.h>
+#include <libraries/codesets.h>
+#include <string.h>
+#include <strings.h>
+
+static FFArosCharset charset, latin1;
+
+static void fillLatin1(FFArosCharset* set, const char* name) {
+    set->name = name;
+    set->utf8 = false;
+    for (unsigned i = 0; i < 128; ++i) {
+        set->high[i] = i < 0x20 ? 0 : 0x80 + i; // C1 controls are no characters of a name
+    }
+}
+
+const FFArosCharset* ffArosCharsetLatin1(void) {
+    if (!latin1.name) {
+        fillLatin1(&latin1, "ISO-8859-1");
+    }
+    return &latin1;
+}
+
+const FFArosCharset* ffArosCharset(void) {
+    if (charset.name) {
+        return &charset;
+    }
+    fillLatin1(&charset, "ISO-8859-1 (codesets.library not available)");
+    struct Library* CodesetsBase = OpenLibrary((CONST_STRPTR) CODESETSNAME, 6);
+    if (!CodesetsBase) {
+        return &charset;
+    }
+    // NULL: the system's set (ENV:CHARSET, else the locale's country).
+    struct TagItem tags[] = { { CSA_FallbackToDefault, TRUE }, { TAG_DONE, 0 } };
+    struct codeset* set = CodesetsFindA(nullptr, tags);
+    static char name[64];
+    if (set && set->name) {
+        strncpy(name, set->name, sizeof(name) - 1);
+        if (strcasecmp(name, "UTF-8") == 0) {
+            charset.name = name;
+            charset.utf8 = true;
+        } else if (strncasecmp(name, "UTF-", 4) != 0) {
+            charset.name = name;
+            for (unsigned i = 0; i < 128; ++i) {
+                uint32_t scalar = set->table[0x80 + i].ucs4;
+                // C1 controls are no characters of a name.
+                charset.high[i] = scalar >= 0xA0 && scalar <= 0x10FFFF && !(scalar >= 0xD800 && scalar <= 0xDFFF) ? scalar : 0;
+            }
+        }
+    }
+    CloseLibrary(CodesetsBase);
+    return &charset;
+}
diff --git a/src/common/aros/aros_charset.h b/src/common/aros/aros_charset.h
new file mode 100644
index 0000000..1b8d433
--- /dev/null
+++ b/src/common/aros/aros_charset.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// The character set of the names the system keeps: volumes, devices,
+// drawers, fonts, screen modes, tasks. AROS stores their bytes as typed,
+// in the 8-bit set the user chose in Locale prefs (ENV:CHARSET), and
+// codesets.library is the system's own answer to which set that is.
+typedef struct FFArosCharset {
+    const char* name; // e.g. "ISO-8859-2"
+    bool utf8;        // names are already UTF-8
+    // Unicode scalar of each byte 0x80..0xFF; 0 where the set has none.
+    uint32_t high[128];
+} FFArosCharset;
+
+// Asked once. Without codesets.library (or a set it cannot describe) it is
+// ISO-8859-1, the Amiga default, and the name says so.
+const FFArosCharset* ffArosCharset(void);
+// ISO-8859-1 itself, for a terminal that says it shows bytes as Latin-1.
+const FFArosCharset* ffArosCharsetLatin1(void);
+
+// The byte that shows `scalar` in the set, or 0 when the set has none.
+static inline unsigned char ffArosCharsetByte(const FFArosCharset* set, uint32_t scalar) {
+    if (scalar < 0x80) {
+        return (unsigned char) scalar;
+    }
+    for (unsigned i = 0; i < 128; ++i) {
+        if (set->high[i] == scalar) {
+            return (unsigned char) (0x80 + i);
+        }
+    }
+    return 0;
+}
