diff --git a/src/detection/terminalshell/terminalshell_aros.c b/src/detection/terminalshell/terminalshell_aros.c
new file mode 100644
index 0000000..a02fdae
--- /dev/null
+++ b/src/detection/terminalshell/terminalshell_aros.c
@@ -0,0 +1,121 @@
+#include "terminalshell.h"
+#include "common/FFcache.h"
+#include "common/aros/aros_terminal.h"
+#include "common/strutil.h"
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <dos/dosextens.h>
+#include <string.h>
+
+static FFShellResult shellResult;
+
+static void destroyShellResult(void* storage) {
+    FFShellResult* result = storage;
+    ffStrbufDestroy(&result->processName);
+    ffStrbufDestroy(&result->exe);
+    ffStrbufDestroy(&result->exePath);
+    ffStrbufDestroy(&result->prettyName);
+    ffStrbufDestroy(&result->version);
+}
+
+static FFcacheEntry ffCacheEntryShell = {
+    .name = "shell",
+    .storage = &shellResult,
+    .destroy = destroyShellResult,
+};
+
+const FFShellResult* ffDetectShell() {
+    FFShellResult* result = &shellResult;
+    if (!ffCacheBeginInit(&ffCacheEntryShell)) {
+        return result;
+    }
+    ffStrbufInit(&result->processName);
+    ffStrbufInit(&result->exe);
+    ffStrbufInit(&result->exePath);
+    ffStrbufInit(&result->prettyName);
+    ffStrbufInit(&result->version);
+    result->exeName = result->exe.chars;
+    result->pid = result->ppid = 0;
+    result->tty = -1;
+
+    // fastfetch runs as a command of an AROS Shell (CLI) process, or from
+    // Workbench without one.
+    if (!Cli()) {
+        return result;
+    }
+    ffStrbufSetStatic(&result->processName, "Shell");
+    ffStrbufSetStatic(&result->prettyName, "AROS Shell");
+    result->pid = (uint32_t) ((struct Process*) FindTask(nullptr))->pr_TaskNum;
+    // No version: the Shell is a resident segment with no file in C: and no
+    // ROM module name to ask (AROS One 1.3 and mainline, checked with
+    // FindResident/OpenResource), so there is nothing to read it from.
+    ffStrbufSet(&result->exe, &result->exePath);
+    result->exeName = result->exe.chars;
+    return result;
+}
+
+static FFTerminalResult terminalResult;
+
+static void destroyTerminalResult(void* storage) {
+    FFTerminalResult* result = storage;
+    ffStrbufDestroy(&result->processName);
+    ffStrbufDestroy(&result->exe);
+    ffStrbufDestroy(&result->exePath);
+    ffStrbufDestroy(&result->prettyName);
+    ffStrbufDestroy(&result->version);
+    ffStrbufDestroy(&result->tty);
+}
+
+static FFcacheEntry ffCacheEntryTerminal = {
+    .name = "terminal",
+    .storage = &terminalResult,
+    .destroy = destroyTerminalResult,
+};
+
+const FFTerminalResult* ffDetectTerminal() {
+    FFTerminalResult* result = &terminalResult;
+    if (!ffCacheBeginInit(&ffCacheEntryTerminal)) {
+        return result;
+    }
+    ffStrbufInit(&result->processName);
+    ffStrbufInit(&result->exe);
+    ffStrbufInit(&result->exePath);
+    ffStrbufInit(&result->prettyName);
+    ffStrbufInit(&result->version);
+    ffStrbufInit(&result->tty);
+    result->exeName = result->exe.chars;
+    result->pid = result->ppid = 0;
+
+    // The console that handles the output: its task's name ("CON", or the
+    // program's path for Limpet's frontend), and the terminal's own name
+    // and version when it answers the identity query.
+    const char* task = ffArosTerminalHandlerTask();
+    if (!*task) {
+        return result;
+    }
+    const char* base = task;
+    for (const char* p = task; *p; ++p) {
+        if (*p == ':' || *p == '/') {
+            base = p + 1;
+        }
+    }
+    ffStrbufSetS(&result->processName, *base ? base : task);
+    if (ffStrContainsC(task, ':')) {
+        ffStrbufSetS(&result->exePath, task);
+        ffStrbufSet(&result->exe, &result->exePath);
+    }
+    result->exeName = result->exe.length ? result->exe.chars + (base - task) : result->exe.chars;
+    const LimpetIdentity* id = ffArosTerminalIdentity();
+    if (id) {
+        ffStrbufSetS(&result->prettyName, id->name);
+        if (id->known & XTY_IDENTITY_KNOWN_VERSION) {
+            ffStrbufSetF(&result->version, "%u.%u.%u", (unsigned) id->major, (unsigned) id->minor, (unsigned) id->patch);
+        }
+    } else if (ffStrEquals(task, "CON")) {
+        ffStrbufSetStatic(&result->prettyName, "CON:");
+    } else {
+        ffStrbufSet(&result->prettyName, &result->processName);
+    }
+    return result;
+}
diff --git a/src/detection/terminalsize/terminalsize_aros.c b/src/detection/terminalsize/terminalsize_aros.c
new file mode 100644
index 0000000..49b0631
--- /dev/null
+++ b/src/detection/terminalsize/terminalsize_aros.c
@@ -0,0 +1,15 @@
+#include "terminalsize.h"
+#include "common/aros/aros_terminal.h"
+
+bool ffDetectTerminalSize(FFTerminalSizeResult* result, [[maybe_unused]] bool fastOnly) {
+    // The size the console reports in its presentation reply. CON: reports
+    // none; its own size request is a console.device unit, not read here.
+    const LimpetPresentation* p = ffArosTerminalPresentation();
+    if (!p || !limpet_columns(p)) {
+        return false;
+    }
+    result->columns = (uint16_t) limpet_columns(p);
+    result->rows = (uint16_t) limpet_rows(p);
+    result->width = result->height = 0;
+    return true;
+}
