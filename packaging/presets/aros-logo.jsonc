// Fastfetch on AROS: the AROS logo as a picture, with the details in three
// groups and bars for memory and disks.   fastfetch -c aros-logo
//
// The picture needs a terminal that confirms Kitty graphics: Limpet 0.8.0
// or later. Elsewhere (CON:, an older Limpet, output to a file) the small
// text logo takes its place. Another picture: --logo FILE, any format a
// picture datatype of your system reads; --logo-width sets its width in
// columns.
//
// "group" names a set of lines that --structure-disabled can leave out,
// heading and break included:
// fastfetch -c aros-logo --structure-disabled network
// Groups: system, hardware, memory-disks, network.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "PROGDIR:share/fastfetch/logos/aros.png",
        "width": 26,
        "position": "auto",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "disableLinewrap": true,
        "separator": "  ",
        "key": {
            "width": 11
        },
        "percent": {
            "type": ["num", "bar"]
        },
        "bar": {
            "width": 12,
            "border": null,
            "char": {
                "elapsed": "■",
                "total": "·"
            }
        },
        "color": {
            "keys": "cyan"
        }
    },
    "modules": [
        "title",
        { "type": "custom", "group": "system", "format": "{#cyan}System" },
        { "type": "os", "group": "system" },
        { "type": "kernel", "group": "system" },
        { "type": "uptime", "group": "system" },
        { "type": "de", "group": "system", "key": "Desktop" },
        { "type": "wm", "group": "system", "key": "WM" },
        { "type": "shell", "group": "system" },
        { "type": "terminal", "group": "system" },
        { "type": "break", "group": "system" },
        { "type": "custom", "group": "hardware", "format": "{#cyan}Hardware" },
        { "type": "cpu", "group": "hardware" },
        {
            "type": "display",
            "group": "hardware",
            "key": "Display",
            "format": "{width}x{height}, {bit-depth}-bit"
        },
        { "type": "break", "group": "hardware" },
        { "type": "custom", "group": "memory-disks", "format": "{#cyan}Memory and disks" },
        {
            "type": "memory",
            "group": "memory-disks",
            "format": "{percentage-bar} {used} / {total}"
        },
        {
            "type": "disk",
            "group": "memory-disks",
            "key": "{mountpoint}",
            "format": "{size-percentage-bar} {size-used} / {size-total}"
        },
        { "type": "break", "group": "memory-disks" },
        { "type": "custom", "group": "network", "format": "{#cyan}Network" },
        { "type": "localip", "group": "network", "key": "IP {ifname}" },
        { "type": "break", "group": "network" },
        "colors"
    ]
}
