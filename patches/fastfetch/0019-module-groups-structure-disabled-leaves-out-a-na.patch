diff --git a/src/common/impl/jsonconfig.c b/src/common/impl/jsonconfig.c
index 6ec8f26..d16d3fa 100644
--- a/src/common/impl/jsonconfig.c
+++ b/src/common/impl/jsonconfig.c
@@ -14,7 +14,7 @@
 #include <inttypes.h>
 
 bool ffJsonConfigParseModuleArgs(yyjson_val* key, yyjson_val* val, FFModuleArgs* moduleArgs) {
-    if (unsafe_yyjson_equals_str(key, "type") || unsafe_yyjson_equals_str(key, "condition")) {
+    if (unsafe_yyjson_equals_str(key, "type") || unsafe_yyjson_equals_str(key, "condition") || unsafe_yyjson_equals_str(key, "group")) {
         return true;
     }
 
@@ -385,6 +385,20 @@ static const char* printJsonConfig(FFdata* data, bool prepare) {
                 FF_DEBUG("The module object at index %zu has no \"type\" key, or it is not a string", idx);
                 return "module object must contain a \"type\" key ( case sensitive )";
             }
+
+            // A name of the user's choosing for several modules, so that
+            // --structure-disabled can leave out a whole group (its heading
+            // and break included) as it leaves out a module type.
+            yyjson_val* group = yyjson_obj_get(module, "group");
+            if (group) {
+                if (!yyjson_is_str(group)) {
+                    FF_DEBUG("'group' is of JSON type %s", yyjson_get_type_desc(group));
+                    return "Property 'group' must be a string";
+                }
+                if (ffStrbufSeparatedContainIgnCaseS(&data->structureDisabled, unsafe_yyjson_get_str(group), ':')) {
+                    continue;
+                }
+            }
             if (yyjson_obj_size(module) == 1) { // contains only Property type
