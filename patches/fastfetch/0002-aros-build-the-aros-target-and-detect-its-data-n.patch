diff --git a/src/detection/font/font_aros.c b/src/detection/font/font_aros.c
new file mode 100644
index 0000000..8271c98
--- /dev/null
+++ b/src/detection/font/font_aros.c
@@ -0,0 +1,46 @@
+#include "font.h"
+
+#include <proto/exec.h>
+#include <proto/intuition.h>
+#include <proto/graphics.h>
+#include <graphics/gfxbase.h>
+#include <intuition/screens.h>
+#include <string.h>
+
+static void setFont(FFstrbuf* out, const char* name, unsigned size) {
+    if (!name || !*name) {
+        return;
+    }
+    size_t n = strlen(name);
+    if (n > 5 && strcmp(name + n - 5, ".font") == 0) {
+        n -= 5;
+    }
+    ffStrbufSetNS(out, (uint32_t) n, name);
+    ffStrbufAppendF(out, " %u", size);
+}
+
+const char* ffDetectFontImpl(FFFontResult* font) {
+    // [0] the Workbench screen's font, [1] the system default (text) font.
+    struct Screen* screen = LockPubScreen(nullptr);
+    if (screen) {
+        if (screen->Font) {
+            setFont(&font->fonts[0], (const char*) screen->Font->ta_Name, screen->Font->ta_YSize);
+        }
+        UnlockPubScreen(nullptr, screen);
+    }
+    if (GfxBase->DefaultFont) {
+        setFont(&font->fonts[1], GfxBase->DefaultFont->tf_Message.mn_Node.ln_Name, GfxBase->DefaultFont->tf_YSize);
+    }
+    if (font->fonts[0].length) {
+        ffStrbufAppend(&font->display, &font->fonts[0]);
+        ffStrbufAppendS(&font->display, " [Screen]");
+    }
+    if (font->fonts[1].length) {
+        if (font->display.length) {
+            ffStrbufAppendS(&font->display, ", ");
+        }
+        ffStrbufAppend(&font->display, &font->fonts[1]);
+        ffStrbufAppendS(&font->display, " [System]");
+    }
+    return nullptr;
+}
