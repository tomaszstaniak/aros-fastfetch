diff --git a/src/detection/locale/locale_aros.c b/src/detection/locale/locale_aros.c
new file mode 100644
index 0000000..79bb385
--- /dev/null
+++ b/src/detection/locale/locale_aros.c
@@ -0,0 +1,39 @@
+#include "locale.h"
+
+#include <proto/exec.h>
+#include <proto/locale.h>
+#include <libraries/locale.h>
+#include <string.h>
+
+static void appendName(FFstrbuf* out, const char* name, const char* suffix) {
+    size_t n = strlen(name), s = strlen(suffix);
+    if (n > s && strcmp(name + n - s, suffix) == 0) {
+        n -= s;
+    }
+    ffStrbufAppendNS(out, (uint32_t) n, name);
+}
+
+const char* ffDetectLocale(FFstrbuf* result) {
+    struct Library* LocaleBase = OpenLibrary((CONST_STRPTR) "locale.library", 0);
+    if (!LocaleBase) {
+        return "locale.library is unavailable";
+    }
+    struct Locale* locale = OpenLocale(nullptr);
+    if (!locale) {
+        CloseLibrary(LocaleBase);
+        return "OpenLocale() failed";
+    }
+    // As Prefs/Locale names them: language and country files.
+    if (locale->loc_LanguageName) {
+        appendName(result, (const char*) locale->loc_LanguageName, ".language");
+    }
+    if (locale->loc_LocaleName) {
+        if (result->length) {
+            ffStrbufAppendS(result, ", ");
+        }
+        appendName(result, (const char*) locale->loc_LocaleName, ".country");
+    }
+    CloseLocale(locale);
+    CloseLibrary(LocaleBase);
+    return result->length ? nullptr : "The locale has no names";
+}
diff --git a/src/detection/localip/localip_aros.c b/src/detection/localip/localip_aros.c
new file mode 100644
index 0000000..44af302
--- /dev/null
+++ b/src/detection/localip/localip_aros.c
@@ -0,0 +1,155 @@
+#include "localip.h"
+#include "common/strutil.h"
+
+#include <proto/exec.h>
+#include <proto/bsdsocket.h>
+#include <sys/socket.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <string.h>
+
+// The SDK's net/if.h follows FreeBSD, where 0x40 is IFF_DRV_RUNNING; AROSTCP
+// reports the 4.4BSD IFF_RUNNING there.
+#ifndef IFF_RUNNING
+    #define IFF_RUNNING 0x40
+#endif
+
+// bsdsocket.library is opened here, by this module only. A program that
+// defines a global SocketBase gets the SDK's net autoinit, which refuses to
+// start without a TCP/IP stack; fastfetch must run without one.
+
+static const FFLocalIpNIFlag niFlagOptions[] = {
+    { IFF_UP, "UP" },
+    { IFF_BROADCAST, "BROADCAST" },
+    { IFF_LOOPBACK, "LOOPBACK" },
+    { IFF_POINTOPOINT, "POINTOPOINT" },
+    { IFF_RUNNING, "RUNNING" },
+    { IFF_NOARP, "NOARP" },
+    { IFF_PROMISC, "PROMISC" },
+    { IFF_ALLMULTI, "ALLMULTI" },
+    { IFF_MULTICAST, "MULTICAST" },
+    {},
+};
+
+static void appendIpv4(FFstrbuf* buffer, const struct sockaddr_in* address, const struct sockaddr_in* netmask) {
+    const uint8_t* b = (const uint8_t*) &address->sin_addr.s_addr;
+    if (buffer->length) {
+        ffStrbufAppendC(buffer, ',');
+    }
+    ffStrbufAppendF(buffer, "%u.%u.%u.%u", b[0], b[1], b[2], b[3]);
+    if (netmask) {
+        int cidr = __builtin_popcount(netmask->sin_addr.s_addr);
+        if (cidr != 0) {
+            ffStrbufAppendF(buffer, "/%d", cidr);
+        }
+    }
+}
+
+const char* ffDetectLocalIps(const FFLocalIpOptions* options, FFlist* results) {
+    if (!(options->showType & FF_LOCALIP_TYPE_IPV4_BIT)) {
+        return "Only IPv4 addresses are read on AROS";
+    }
+    struct Library* SocketBase = OpenLibrary((CONST_STRPTR) "bsdsocket.library", 4);
+    if (!SocketBase) {
+        return "No TCP/IP stack is running (bsdsocket.library is not available)";
+    }
+    const char* error = nullptr;
+    LONG s = socket(AF_INET, SOCK_DGRAM, 0);
+    if (s < 0) {
+        CloseLibrary(SocketBase);
+        return "socket() failed";
+    }
+
+    char buffer[4096];
+    struct ifconf ifc = { .ifc_len = sizeof(buffer), .ifc_buf = buffer };
+    if (IoctlSocket(s, SIOCGIFCONF, (char*) &ifc) < 0) {
+        error = "SIOCGIFCONF failed";
+        goto exit;
+    }
+
+    // BSD entries vary in length: the name, then an address of sa_len bytes
+    // (at least a struct sockaddr).
+    for (char* p = buffer; p < buffer + ifc.ifc_len;) {
+        struct ifreq* entry = (struct ifreq*) p;
+        size_t addressLength = entry->ifr_addr.sa_len > sizeof(struct sockaddr) ? entry->ifr_addr.sa_len : sizeof(struct sockaddr);
+        p += sizeof(entry->ifr_name) + addressLength;
+        if (entry->ifr_addr.sa_family != AF_INET) {
+            continue;
+        }
+        if (options->namePrefix.length && strncmp(entry->ifr_name, options->namePrefix.chars, options->namePrefix.length) != 0) {
+            continue;
+        }
+
+        struct ifreq request;
+        memset(&request, 0, sizeof(request));
+        memcpy(request.ifr_name, entry->ifr_name, sizeof(request.ifr_name)); // NUL-padded, as SIOCGIFCONF gave it
+        short flags = IoctlSocket(s, SIOCGIFFLAGS, (char*) &request) == 0 ? request.ifr_flags : 0;
+        if (!(flags & IFF_UP)) {
+            continue;
+        }
+        if ((flags & IFF_LOOPBACK) && !(options->showType & FF_LOCALIP_TYPE_LOOP_BIT)) {
+            continue;
+        }
+
+        // AROSTCP's routing table is not read here. The default route is
+        // taken to go through the first interface that is up and not the
+        // loopback, which on a desktop with one network card it does.
+        bool isDefault = !(flags & IFF_LOOPBACK);
+        for (uint32_t i = 0; isDefault && i < results->length; ++i) {
+            if (FF_LIST_GET(FFLocalIpResult, *results, i)->defaultRoute & FF_LOCALIP_TYPE_IPV4_BIT) {
+                isDefault = false;
+            }
+        }
+        if ((options->showType & FF_LOCALIP_TYPE_DEFAULT_ROUTE_ONLY_BIT) && !isDefault) {
+            continue;
+        }
+
+        FFLocalIpResult* item = nullptr;
+        for (uint32_t i = 0; i < results->length; ++i) {
+            FFLocalIpResult* existing = FF_LIST_GET(FFLocalIpResult, *results, i);
+            if (existing->name.length == strnlen(entry->ifr_name, sizeof(entry->ifr_name)) &&
+                memcmp(existing->name.chars, entry->ifr_name, existing->name.length) == 0) {
+                item = existing;
+            }
+        }
+        if (!item) {
+            item = FF_LIST_ADD(FFLocalIpResult, *results);
+            // A name of IFNAMSIZ characters has no NUL.
+            ffStrbufInitNS(&item->name, (uint32_t) strnlen(entry->ifr_name, sizeof(entry->ifr_name)), entry->ifr_name);
+            ffStrbufInit(&item->ipv4);
+            ffStrbufInit(&item->ipv6);
+            ffStrbufInit(&item->mac);
+            ffStrbufInit(&item->flags);
+            item->defaultRoute = isDefault ? FF_LOCALIP_TYPE_IPV4_BIT : FF_LOCALIP_TYPE_NONE;
+            item->mtu = -1;
+            item->speed = -1;
+            if (options->showType & FF_LOCALIP_TYPE_FLAGS_BIT) {
+                ffLocalIpFillNIFlags(&item->flags, (uint16_t) flags, niFlagOptions);
+            }
+            if ((options->showType & FF_LOCALIP_TYPE_MTU_BIT) && IoctlSocket(s, SIOCGIFMTU, (char*) &request) == 0) {
+                item->mtu = request.ifr_mtu;
+            }
+        } else if (!(options->showType & FF_LOCALIP_TYPE_ALL_IPS_BIT)) {
+            continue;
+        }
+
+        struct sockaddr_in netmask;
+        bool haveMask = false;
+        if (options->showType & FF_LOCALIP_TYPE_PREFIX_LEN_BIT) {
+            memset(&request.ifr_addr, 0, sizeof(request.ifr_addr));
+            if (IoctlSocket(s, SIOCGIFNETMASK, (char*) &request) == 0) {
+                memcpy(&netmask, &request.ifr_addr, sizeof(netmask));
+                haveMask = true;
+            }
+        }
+        struct sockaddr_in address;
+        memcpy(&address, &entry->ifr_addr, sizeof(address));
+        appendIpv4(&item->ipv4, &address, haveMask ? &netmask : nullptr);
+    }
+
+exit:
+    CloseSocket(s);
+    CloseLibrary(SocketBase);
+    return error;
+}
