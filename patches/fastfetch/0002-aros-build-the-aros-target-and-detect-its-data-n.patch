+++ b/src/detection/memory/memory_aros.c
@@ -0,0 +1,14 @@
+#include "memory.h"
+
+#include <proto/exec.h>
+
+const char* ffDetectMemory(FFMemoryResult* ram) {
+    // All memory exec manages; MEMF_TOTAL counts what free does not.
+    ram->bytesTotal = AvailMem(MEMF_ANY | MEMF_TOTAL);
+    uint64_t available = AvailMem(MEMF_ANY);
+    if (ram->bytesTotal == 0 || available > ram->bytesTotal) {
+        return "AvailMem() returned no usable totals";
+    }
+    ram->bytesUsed = ram->bytesTotal - available;
+    return nullptr;
+}
