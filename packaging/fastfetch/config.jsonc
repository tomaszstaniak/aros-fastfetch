// Fastfetch on AROS: the compact view.
//
// This file is read when you have no configuration of your own: Fastfetch
// looks in ENVARC:fastfetch/, ENV:fastfetch/ and then here, beside the
// program. To change it, copy it to ENVARC:fastfetch/config.jsonc and edit
// that copy, or write a full one with  fastfetch --gen-config
//
// The small logo goes above the list when the window is too narrow for it
// beside (Limpet reports its width; in CON: it stays on the left), and long
// lines are cut at the window's edge instead of wrapping under the logo.
// fastfetch -c aros-logo  shows the AROS logo as a picture in Limpet.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "position": "auto",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "disableLinewrap": true
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "shell",
        {
            "type": "display",
            "key": "Display",
            "format": "{width}x{height} ({name})"
        },
        {
            "type": "de",
            "key": "Desktop"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        "terminal",
        "cpu",
        "memory",
        {
            "type": "disk",
            "key": "Disk {mountpoint}"
        },
        "localip",
        "locale",
        "break",
        "colors"
    ]
}
