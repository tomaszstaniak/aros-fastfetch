diff --git a/src/common/aros/aros_memmem.c b/src/common/aros/aros_memmem.c
new file mode 100644
index 0000000..af6dffd
--- /dev/null
+++ b/src/common/aros/aros_memmem.c
@@ -0,0 +1,25 @@
+#include "aros_memmem.h"
+
+#include <string.h>
+
+void* memmem(const void* haystack, size_t haystackLength, const void* needle, size_t needleLength) {
+    if (needleLength == 0) {
+        return (void*) haystack;
+    }
+    if (haystackLength < needleLength) {
+        return NULL;
+    }
+    const unsigned char* h = haystack;
+    const unsigned char* last = h + (haystackLength - needleLength);
+    const unsigned char first = *(const unsigned char*) needle;
+    for (; h <= last; h++) {
+        h = memchr(h, first, (size_t) (last - h) + 1);
+        if (!h) {
+            return NULL;
+        }
+        if (memcmp(h, needle, needleLength) == 0) {
+            return (void*) h;
+        }
+    }
+    return NULL;
+}
diff --git a/src/common/aros/aros_memmem.h b/src/common/aros/aros_memmem.h
new file mode 100644
