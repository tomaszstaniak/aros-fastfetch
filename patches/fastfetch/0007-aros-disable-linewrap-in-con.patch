From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Tue, 27 Oct 2026 12:00:00 +0100
Subject: [PATCH] AROS: --disable-linewrap in CON:

Repository: https://github.com/fastfetch-cli/fastfetch
Base: fastfetch 2.70.0, 17bb3fd2384bd814b421d73b8c8b8d08e06cfa26
Problem: --disable-linewrap is off in pipe mode, and CON: is written in
pipe mode because it shows no ANSI colours; a request to keep long lines
to one row had no effect there.
Solution: on an interactive AROS console that is written plain, use the
Amiga console's own mode (console.device CSI > 7 l, restored with
CSI > 7 h). Redirected output still gets no sequence.
Scope: common/impl/init.c, AROS only. Terminals that take colours (Limpet)
keep the DEC mode CSI ? 7 l as before.
Upstream-Status: AROS-specific.
Verification: --disable-linewrap true in CON: on pool v1-1 and v11-1
(2026-10-27): long lines stayed on one row; redirected output had no ESC.
Removal: with upstream AROS support.
---
 src/common/impl/init.c | 23 +++++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/src/common/impl/init.c b/src/common/impl/init.c
index d6758ba..99691c0 100644
--- a/src/common/impl/init.c
+++ b/src/common/impl/init.c
@@ -77,10 +77,18 @@ void ffInitInstance(void) {
 
 static volatile bool ffDisableLinewrap = false;
 static volatile bool ffHideCursor = false;
+#ifdef __AROS__
+    #include "common/aros/aros_terminal.h"
+static const char* ffLinewrapOff = "\033[?7l";
+static const char* ffLinewrapOn = "\033[?7h";
+#else
+    #define ffLinewrapOff "\033[?7l"
+    #define ffLinewrapOn "\033[?7h"
+#endif
 
 static void resetConsole(void) {
     if (ffDisableLinewrap) {
-        fputs("\033[?7h", stdout);
+        fputs(ffLinewrapOn, stdout);
     }
 
     if (ffHideCursor) {
@@ -111,6 +119,17 @@ static void exitSignalHandler([[maybe_unused]] int signal) {
 void ffStart(void) {
     ffDisableLinewrap = instance.config.display.disableLinewrap && !instance.config.display.pipe;
     ffHideCursor = instance.config.display.hideCursor && !instance.config.display.pipe;
+#ifdef __AROS__
+    // CON: gets plain text, yet it is an interactive console: there the
+    // request is honoured with the Amiga console's own mode (console.device
+    // CSI > 7 l / h). Redirected output gets no sequence at all.
+    if (instance.config.display.disableLinewrap && instance.config.display.pipe && ffArosTerminalPlain() &&
+        *ffArosTerminalHandlerTask()) {
+        ffDisableLinewrap = true;
+        ffLinewrapOff = "\033[>7l";
+        ffLinewrapOn = "\033[>7h";
+    }
+#endif
 
 #ifdef _WIN32
     SetErrorMode(SEM_FAILCRITICALERRORS);
@@ -147,7 +166,7 @@ void ffStart(void) {
     }
 
     if (ffDisableLinewrap) {
-        fputs("\033[?7l", stdout);
+        fputs(ffLinewrapOff, stdout);
     }
 
     if (instance.state.dynamicInterval > 0) {
