// Fastfetch on AROS: the AROS logo as a picture, with the details in three
// groups and bars for memory and disks.   fastfetch -c aros-logo
//
// The picture needs a terminal that confirms Kitty graphics: Limpet 0.8.0
// or later. Elsewhere (CON:, an older Limpet, output to a file) the small
// text logo takes its place. Another picture: --logo FILE, any format a
// picture datatype of your system reads; --logo-width sets its width in
// columns.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "PROGDIR:share/fastfetch/logos/aros.png",
        "width": 26,
        "position": "auto",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "disableLinewrap": true,
        "separator": "  ",
        "key": {
            "width": 10
        },
        "bar": {
            "width": 12,
            "border": null,
            "char": {
                "elapsed": "■",
                "total": "·"
            }
        },
        "color": {
            "keys": "cyan"
        }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "{#cyan}System"
        },
        "os",
        "kernel",
        "uptime",
        {
            "type": "de",
            "key": "Desktop"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        "shell",
        "terminal",
        "break",
        {
            "type": "custom",
            "format": "{#cyan}Hardware"
        },
        "cpu",
        {
            "type": "display",
            "key": "Display",
            "format": "{width}x{height}, {bit-depth}-bit"
        },
        "localip",
        "break",
        {
            "type": "custom",
            "format": "{#cyan}Memory and disks"
        },
        {
            "type": "memory",
            "format": "{percentage-bar} {used} / {total}"
        },
        {
            "type": "disk",
            "key": "{mountpoint}",
            "format": "{size-percentage-bar} {size-used} / {size-total}"
        },
        "break",
        "colors"
    ]
}
