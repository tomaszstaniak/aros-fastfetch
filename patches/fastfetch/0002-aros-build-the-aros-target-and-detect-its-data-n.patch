diff --git a/src/detection/os/os_aros.c b/src/detection/os/os_aros.c
new file mode 100644
index 0000000..104ba34
--- /dev/null
+++ b/src/detection/os/os_aros.c
@@ -0,0 +1,47 @@
+#include "os.h"
+#include "common/strutil.h"
+
+#include <proto/exec.h>
+#include <proto/aros.h>
+#include <aros/inquire.h>
+#include <sys/utsname.h>
+
+void ffDetectOSImpl(FFOSResult* os) {
+    ffStrbufSetStatic(&os->name, "AROS");
+    ffStrbufSetStatic(&os->id, "aros");
+    // The ABI and platform this binary is built for: it runs only there.
+    // aros.library's AI_ArosABIMajor answers on ABIv11 only (mainline and
+    // the Pi report it as unknown), so the build target is the source.
+#if defined(FF_AROS_TARGET)
+    const char* target = FF_AROS_TARGET;
+    if (ffStrContains(target, "-abiv11-")) {
+        ffStrbufSetStatic(&os->variant, "ABIv11");
+    } else if (ffStrContains(target, "-abiv1-")) {
+        ffStrbufSetStatic(&os->variant, ffStrEndsWith(target, "-raspi") ? "ABIv1, Raspberry Pi" : "ABIv1");
+    }
+    ffStrbufSetS(&os->variantID, target);
+#endif
+
+    // A distribution that names itself does so through aros.library; most
+    // (AROS One 1.3, mainline, the Pi system of 2026-08-22) leave it empty,
+    // and then no distribution is guessed. Without one the OS module builds
+    // "AROS (ABIv11)" from name and variant; a pretty name replaces that
+    // whole line, so it carries the variant itself.
+    struct Library* ArosBase = OpenLibrary((CONST_STRPTR) "aros.library", 0);
+    if (ArosBase) {
+        STRPTR distribution = nullptr;
+        ArosInquire(AI_ArosVariant, (IPTR) &distribution, TAG_DONE);
+        if (distribution && *distribution) {
+            ffStrbufSetF(&os->prettyName, "AROS %s", (const char*) distribution);
+            if (os->variant.length) {
+                ffStrbufAppendF(&os->prettyName, " (%s)", os->variant.chars);
+            }
+        }
+        CloseLibrary(ArosBase);
+    }
+
+    struct utsname u;
+    if (uname(&u) == 0) {
+        ffStrbufSetS(&os->buildID, u.version);
+    }
+}
