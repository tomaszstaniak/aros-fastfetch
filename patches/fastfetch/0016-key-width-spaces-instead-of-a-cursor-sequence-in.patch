From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Tue, 27 Oct 2026 09:27:09 +0100
Subject: [PATCH] Key width: spaces instead of a cursor sequence in pipe mode

Repository: https://github.com/fastfetch-cli/fastfetch
Base: fastfetch 2.70.0, 17bb3fd2384bd814b421d73b8c8b8d08e06cfa26
Problem: with display.key.width (or a module's keyWidth) the value is
moved to its column with CSI n G even with --pipe or redirected output.
A file got escape sequences, and a console without them (the AROS CON:
window, written in pipe mode) showed "[39G" before every value.
Solution: in pipe mode the key is padded with spaces to the same column;
a key longer than the width is left as it is. Columns are counted in code
points. Terminal output without --pipe is unchanged.
Scope: common/impl/printing.c. All platforms.
Upstream-Status: suitable for upstream.
Verification: guest runs: docs/evidence/2026-10-27-r2/ (the aros-logo
preset in CON: and redirected to a file).
Removal: when upstream keeps pipe mode free of cursor sequences.
---
 src/common/impl/printing.c | 26 ++++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/src/common/impl/printing.c b/src/common/impl/printing.c
index 2980544..43463bc 100644
--- a/src/common/impl/printing.c
+++ b/src/common/impl/printing.c
@@ -3,6 +3,16 @@
 #include "common/textModifier.h"
 #include "logo/logo.h"
 
+#include <string.h>
+
+static uint32_t countCodePoints(const char* text, size_t length) {
+    uint32_t n = 0;
+    for (size_t i = 0; i < length; ++i) {
+        n += ((unsigned char) text[i] & 0xC0) != 0x80;
+    }
+    return n;
+}
+
 void ffPrintLogoAndKey(const char* moduleName, uint32_t moduleIndex, const FFModuleArgs* moduleArgs, FFPrintType printType) {
     ffLogoPrintLine();
 
@@ -28,19 +38,26 @@ void ffPrintLogoAndKey(const char* moduleName, uint32_t moduleIndex, const FFMod
             }
         }
 
+        // Columns written for the key, for aligning it in pipe mode, where
+        // no cursor sequence may be sent. Code points, not cell widths.
+        uint32_t keyColumns = 0;
+
         if (instance.config.display.keyType & FF_MODULE_KEY_TYPE_ICON && moduleArgs && moduleArgs->keyIcon.length > 0) {
             ffStrbufWriteTo(&moduleArgs->keyIcon, stdout);
+            keyColumns += countCodePoints(moduleArgs->keyIcon.chars, moduleArgs->keyIcon.length);
         }
 
         if (instance.config.display.keyType & FF_MODULE_KEY_TYPE_STRING) {
             ffPrintCharTimes(' ', instance.config.display.keyType >> FF_MODULE_KEY_TYPE_SPACE_SHIFT);
+            keyColumns += instance.config.display.keyType >> FF_MODULE_KEY_TYPE_SPACE_SHIFT;
 
             // nullptr check is required for modules with custom keys, e.g. disk with the folder path
             if ((printType & FF_PRINT_TYPE_NO_CUSTOM_KEY) || !moduleArgs || moduleArgs->key.length == 0) {
                 fputs(moduleName, stdout);
+                keyColumns += countCodePoints(moduleName, strlen(moduleName));
 
                 if (moduleIndex > 0) {
-                    printf(" %u", moduleIndex);
+                    keyColumns += (uint32_t) printf(" %u", moduleIndex);
                 }
             } else {
                 FF_STRBUF_AUTO_DESTROY key = ffStrbufCreate();
@@ -50,6 +67,7 @@ void ffPrintLogoAndKey(const char* moduleName, uint32_t moduleIndex, const FFMod
                                                                            FF_ARG(moduleName, "module-name"),
                                                                        }));
                 ffStrbufWriteTo(&key, stdout);
+                keyColumns += countCodePoints(key.chars, key.length);
             }
         }
 
@@ -59,6 +77,7 @@ void ffPrintLogoAndKey(const char* moduleName, uint32_t moduleIndex, const FFMod
         }
 
         ffStrbufWriteTo(&instance.config.display.keyValueSeparator, stdout);
+        keyColumns += countCodePoints(instance.config.display.keyValueSeparator.chars, instance.config.display.keyValueSeparator.length);
 
         if (!instance.config.display.pipe && instance.config.display.colorSeparator.length) {
             fputs(FASTFETCH_TEXT_MODIFIER_RESET, stdout);
@@ -66,7 +85,10 @@ void ffPrintLogoAndKey(const char* moduleName, uint32_t moduleIndex, const FFMod
 
         if (!(printType & FF_PRINT_TYPE_NO_CUSTOM_KEY_WIDTH)) {
             uint32_t keyWidth = moduleArgs && moduleArgs->keyWidth > 0 ? moduleArgs->keyWidth : instance.config.display.keyWidth;
-            if (keyWidth > 0) {
+            if (keyWidth > 0 && instance.config.display.pipe) {
+                // Plain text: spaces to the column (a longer key is not cut).
+                ffPrintCharTimes(' ', keyWidth > keyColumns + 1 ? keyWidth - keyColumns - 1 : 0);
+            } else if (keyWidth > 0) {
                 printf("\e[%uG", (unsigned) (keyWidth + instance.state.logoWidth));
             }
         }
